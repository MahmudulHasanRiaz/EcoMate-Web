model Refund {
  id          String    @id @default(uuid())
  orderId     String
  amount      Decimal   @db.Decimal(10, 2)
  reason      String?
  status      String    @default("pending")
  processedBy String?
  processedAt DateTime?
  notes       String?   @db.Text
  /// D5 (Task 9): where the money went back (gateway code / account label,
  /// e.g. 'bkash'). Required for every refund recorded after the payment-
  /// ledger overhaul; NULL marks a legacy pre-ledger refund. The gate uses
  /// this to tell mirrored refunds (method set + matching negative payment
  /// row — counted via the ledger) from legacy ones (method NULL — counted
  /// via the Refund row) without ever double-counting.
  method      String?
  /// EXCHANGE settlement only: the exchange that produced this refund. The
  /// refund is still raised against `orderId` (the ORIGINAL whose money is
  /// being returned) — this column is the traceability link back to the
  /// exchange, so a refund is never an orphan row.
  exchangeOrderId String?
  /// EXCHANGE settlement only: the specific payment row the money came back
  /// from. Lets a refund be reconciled against the exact collection instead of
  /// the order total.
  sourcePaymentId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  exchangeOrder Order?   @relation("RefundExchangeOrder", fields: [exchangeOrderId], references: [id])
  sourcePayment Payment? @relation("RefundSourcePayment", fields: [sourcePaymentId], references: [id])
  processor UserProfile? @relation("RefundProcessor", fields: [processedBy], references: [id])

  @@index([orderId])
  @@index([exchangeOrderId])
}

