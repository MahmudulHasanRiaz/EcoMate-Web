  @@index([employeeId, effectiveFrom])
}

/// Reusable working-hours template (e.g. "General 09:00-17:00"). Times are
/// wall-clock strings in Asia/Dhaka, matching the attendance business day.
model ShiftPreset {
  id              String   @id @default(uuid())
  name            String   @unique
  code            String   @unique
  startTime       String // "09:00"
  endTime         String // "17:00"
  graceMinutes    Int      @default(10)
  breakMinutes    Int      @default(60)
  /// Computed at write time: shift span minus the standard break. Stored so the
  /// admin UI and overtime maths never disagree about what a shift is worth.
  standardMinutes Int
  /// endTime < startTime => the shift crosses midnight. Explicit, so night
  /// shifts are never inferred by arithmetic guesswork at read time.
  overnight       Boolean  @default(false)
  isActive        Boolean  @default(true)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignments ShiftAssignment[]

  @@index([isActive])
}

/// One weekday's shift for one employee. Effective-dated so a rotation change
/// never rewrites historical days - the same close-and-recreate discipline as
/// WeeklyOff.
model ShiftAssignment {
  id            String    @id @default(uuid())
  employeeId    String
  shiftPresetId String
  dayOfWeek     Int // 0 = Sunday ... 6 = Saturday
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime? // null = currently in force
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftPreset ShiftPreset  @relation(fields: [shiftPresetId], references: [id], onDelete: Restrict)
  createdBy   UserProfile? @relation("ShiftAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([employeeId, dayOfWeek, effectiveFrom])
  @@index([employeeId, effectiveTo])
  @@index([shiftPresetId, effectiveTo])
}

enum AccountType {
