generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  inactive
  invited
  suspended
}

enum UserRole {
  superadmin
  admin
  cashier
  manager
  packing_assistant
  customer
  employee
}

enum AvailabilityMode {
  ALWAYS_IN_STOCK
  ALWAYS_OUT_OF_STOCK
  MANAGED_STOCK
  INVENTORY_CONTROLLED
}

enum TaskStatus {
  backlog
  todo
  in_progress @map("in progress")
  done
  canceled
}

enum TaskLabel {
  bug
  feature
  documentation
}

enum TaskPriority {
  low
  medium
  high
  critical
}

enum PaymentOptionType {
  FULL_PAYMENT
  PARTIAL_PAYMENT
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PAYMENT_PENDING
  PENDING
  PAID
  PARTIAL_PAID
  PARTIAL_REFUNDED
  UNPAID
  FAILED
  CANCELLED
  REFUNDED
  PAYMENT_VERIFYING
}

enum WarehouseType {
  main
  showroom
  storage
}

enum CostingLotConsumptionType {
  FULFILLMENT
  ADJUSTMENT
  TRANSFER_OUT
}

enum OrderSource {
  POS
  ECOMMERCE
  MANUAL
}

enum SalesChannel {
  CALL
  FACEBOOK
  INSTAGRAM
  TIKTOK
  MESSENGER
  WHATSAPP
  THREADS
  WALK_IN
  WEBSITE
  OFFLINE
  POS
  OTHER
}

model UserProfile {
  id                  String     @id @default(uuid())
  firstName           String
  lastName            String
  username            String     @unique
  email               String     @unique
  phoneNumber         String
  password            String
  emailVerified       Boolean    @default(false)
  failedLoginAttempts Int        @default(0)
  lockoutUntil        DateTime?
  lastIp              String?
  betterAuthUserId    String?    @unique
  status              UserStatus @default(active)
  role                UserRole   @default(admin)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  tasks          Task[]
  settings       UserSettings?
  refreshTokens  RefreshToken[]
  addresses      Address[]
  assignedOrders Order[]         @relation("OrderAssignee")
  payments       Payment[]       @relation("VerifiedPayments")
  refunds        Refund[]        @relation("RefundProcessor")
  assignedLeads  CheckoutLead[]  @relation("CheckoutLeadAssignedTo")
  assignedByMe   CheckoutLead[]  @relation("CheckoutLeadAssignedBy")
  convertedLeads CheckoutLead[]  @relation("CheckoutLeadConvertedBy")
  referrals      Referral[]
  posSessions    PosSession[]
  employmentHistory EmploymentHistory[] @relation("EmploymentChangedBy")
  weeklyOffsCreated WeeklyOff[]         @relation("WeeklyOffCreatedBy")
  packingLocks   PackingLock[]
  orderEditLocks OrderEditLock[]

  @@index([role])
  @@index([status])
  @@index([phoneNumber])
  @@map("User")
}

model betterAuthUser {
  id                   String   @id @default(cuid())
  name                 String
  email                String   @unique
  emailVerified        Boolean  @default(false)
  image                String?
  role                 String?  @default("customer")
  override_permissions String[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  accounts        betterAuthAccount[]
  sessions        betterAuthSession[]
  customerProfile CustomerProfile?
  employee        Employee?

  @@map("better_auth_users")
}

model betterAuthSession {
  id        String         @id @default(cuid())
  token     String         @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      betterAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model betterAuthAccount {
  id                    String         @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  user                  betterAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model betterAuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model VerificationToken {
  id        String    @id @default(uuid())
  email     String
  token     String
  type      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, type])
  @@index([token, type])
}

model AccessPreset {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @db.Text
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]
}

model AuthSettings {
  id           String   @id @default(uuid())
  providerName String   @unique
  isEnabled    Boolean  @default(false)
  clientId     String
  clientSecret String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("auth_settings")
}

model CustomerProfile {
  id               String   @id @default(uuid())
  betterAuthUserId String?  @unique
  externalId       String?  @unique
  phone            String   @unique
  email            String?
  name             String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  betterAuthUser betterAuthUser? @relation(fields: [betterAuthUserId], references: [id], onDelete: SetNull)
  orders         Order[]
  addresses      Address[]

  @@index([email])
}

model Task {
  id          String       @id @default(uuid())
  displayId   String       @unique
  title       String
  status      TaskStatus   @default(todo)
  label       TaskLabel    @default(feature)
  priority    TaskPriority @default(medium)
  assignee    String?
  description String?
  dueDate     DateTime?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  createdBy UserProfile @relation(fields: [createdById], references: [id])

  @@index([createdById])
  @@index([assignee])
  @@index([status])
}

model UserSettings {
  id     String @id @default(uuid())
  userId String @unique

  theme                          String   @default("light")
  font                           String   @default("inter")
  username                       String?
  email                          String?
  bio                            String?
  urls                           String?
  accountName                    String?
  accountDob                     String?
  accountLanguage                String?
  notificationType               String   @default("all")
  notificationMobile             Boolean  @default(false)
  notificationCommunicationEmail Boolean  @default(false)
  notificationSocialEmail        Boolean  @default(false)
  notificationMarketingEmail     Boolean  @default(false)
  notificationSecurityEmail      Boolean  @default(true)
  displayItems                   String?
  autoVariantSelect              Boolean  @default(true)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id          String   @id @default(uuid())
  userId      String?
  label       String // "Home", "Office", etc.
  fullName    String
  phoneNumber String
  street      String
  city        String
  state       String?
  zipCode     String?
  country     String   @default("Bangladesh")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user              UserProfile?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerProfileId String?
  customerProfile   CustomerProfile? @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([customerProfileId])
  @@index([userId, isDefault, createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  parentId      String?
  image         String?
  sortOrder     Int      @default(0)
  showInMenu    Boolean  @default(true)
  menuSortOrder Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent            Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children          Category[]        @relation("CategoryTree")
  products          Product[]         @relation("ProductCategory")
  productCategories ProductCategory[]
  combos            Combo[]
  sizeChartId       String?
  sizeChart         SizeChart?        @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model Brand {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logo      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[] @relation("ProductBrand")
}

model Attribute {
  id        String           @id @default(uuid())
  name      String           @unique
  values    AttributeValue[]
  createdAt DateTime         @default(now())
}

model AttributeValue {
  id          String  @id @default(uuid())
  value       String
  hexCode     String?
  attributeId String
  sortOrder   Int     @default(0)

  attribute Attribute                      @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants  ProductVariantAttributeValue[]
}

model Product {
  id                   String           @id @default(uuid())
  name                 String
  slug                 String           @unique
  type                 String           @default("simple")
  description          String?          @db.Text
  shortDesc            String?          @db.Text
  basePrice            Decimal          @db.Decimal(10, 2)
  salePrice            Decimal?         @db.Decimal(10, 2)
  sku                  String?
  managedStockQuantity Int              @default(0) @map("stock")
  lowStockQty          Int?
  availabilityMode     AvailabilityMode @default(MANAGED_STOCK)
  standardCost         Decimal?         @db.Decimal(10, 2)
  categoryId           String?
  tags                 Json?            @default("[]")
  images               Json?            @default("[]")
  seoMeta              Json?            @default("{}")
  isFeatured           Boolean          @default(false)
  isActive             Boolean          @default(true)
  status               String           @default("active")
  manageStock          Boolean          @default(false)
  syncManagedStock     Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  brandId                  String?
  brand                    Brand?                    @relation("ProductBrand", fields: [brandId], references: [id], onDelete: SetNull)
  reservedStock            Int                       @default(0)
  warehouseId              String?
  defaultBinLocationId     String?
  warehouse                Warehouse?                @relation(fields: [warehouseId], references: [id])
  defaultBinLocation       BinLocation?              @relation("ProductDefaultBin", fields: [defaultBinLocationId], references: [id])
  category                 Category?                 @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  productCategories        ProductCategory[]
  productTags              ProductTag[]
  variants                 ProductVariant[]
  orderItems               OrderItem[]
  comboItems               ComboItem[]
  sizeChartId              String?
  sizeChart                SizeChart?                @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  reviews                  Review[]
  paymentOptionOverrides   ProductPaymentOption[]
  purchaseItems            PurchaseItem[]
  physicalInventories      PhysicalInventory[]
  physicalLedgers          PhysicalInventoryLedger[]
  physicalReservations     PhysicalReservation[]
  orderItemComboComponents OrderItemComboComponent[]

  @@index([isActive])
  @@index([categoryId])
  @@index([createdAt])
  @@index([sku])
  @@index([type])
  @@index([brandId])
}

model ProductVariant {
  id                   String   @id @default(uuid())
  productId            String
  sku                  String   @unique
  sortOrder            Int      @default(0)
  price                Decimal? @db.Decimal(10, 2)
  salePrice            Decimal? @db.Decimal(10, 2)
  managedStockQuantity Int      @default(0) @map("stock")
  standardCost         Decimal? @db.Decimal(10, 2)
  image                String?
  images               Json?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  product             Product                        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues     ProductVariantAttributeValue[]
  orderItems          OrderItem[]
  comboItems          ComboItem[]
  purchaseItems       PurchaseItem[]
  reservedStock       Int                            @default(0)
  warehouseId         String?
  binLocationId       String?
  warehouse           Warehouse?                     @relation(fields: [warehouseId], references: [id])
  binLocation         BinLocation?                   @relation("VariantBin", fields: [binLocationId], references: [id])
  physicalInventories PhysicalInventory[]
  physicalLedgers     PhysicalInventoryLedger[]

  @@index([productId])
}

model ProductVariantAttributeValue {
  id               String @id @default(uuid())
  variantId        String
  attributeValueId String

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, attributeValueId])
}

model Combo {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  shortDesc   String?   @db.Text
  basePrice   Decimal   @db.Decimal(10, 2)
  salePrice   Decimal?  @db.Decimal(10, 2)
  image       String?
  images      Json?     @default("[]")
  categoryId  String?
  tags        Json?     @default("[]")
  seoMeta     Json?     @default("{}")
  isFeatured  Boolean   @default(false)
  isActive    Boolean   @default(true)
  manageStock Boolean   @default(false)
  stock       Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category               Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items                  ComboItem[]
  orderItems             OrderItem[]
  paymentOptionOverrides ProductPaymentOption[]
  reservedStock          Int                    @default(0)
  warehouseId            String?
  warehouse              Warehouse?             @relation(fields: [warehouseId], references: [id])

  @@index([isActive])
}

model ComboItem {
  id        String   @id @default(uuid())
  comboId   String
  productId String
  variantId String?
  quantity  Int      @default(1)
  price     Decimal? @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  combo   Combo           @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([comboId, productId, variantId])
}

enum PosSessionStatus {
  open
  closed
  cancelled
}

model PosSession {
  id              String           @id @default(uuid())
  showroomId      String
  showroom        Warehouse        @relation(fields: [showroomId], references: [id])
  cashierId       String
  cashier         UserProfile      @relation(fields: [cashierId], references: [id])
  openingBalance  Decimal          @db.Decimal(10, 2)
  closingBalance  Decimal?         @db.Decimal(10, 2)
  expectedBalance Decimal?         @db.Decimal(10, 2)
  status          PosSessionStatus @default(open)
  openedAt        DateTime         @default(now())
  closedAt        DateTime?
  notes           String?
  orders          Order[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([showroomId])
  @@index([cashierId])
  @@index([status])
}

model PackingLock {
  id        String      @id @default(uuid())
  orderId   String      @unique
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  packerId  String
  packer    UserProfile @relation(fields: [packerId], references: [id])
  startedAt DateTime    @default(now())
  expiresAt DateTime?

  @@index([packerId])
}

model OrderEditLock {
  id          String      @id @default(uuid())
  orderId     String      @unique
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId      String
  user        UserProfile @relation(fields: [userId], references: [id])
  acquiredAt  DateTime    @default(now())
  heartbeatAt DateTime    @default(now())
  expiresAt   DateTime

  @@index([userId])
  @@index([expiresAt])
}

model OrderStatus {
  id           String   @id @default(uuid())
  name         String   @unique
  color        String   @default("#6B7280")
  nextStatuses Json?    @default("[]")
  isInitial    Boolean  @default(false)
  isFinal      Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  orders Order[]
  commissionRules CommissionRule[]
}

model Order {
  id                       String             @id @default(uuid())
  displayId                String             @unique
  customerId               String?
  statusId                 String
  subtotal                 Decimal            @db.Decimal(10, 2)
  shippingCharge           Decimal            @default(0) @db.Decimal(10, 2)
  discount                 Decimal            @default(0) @db.Decimal(10, 2)
  discountType             String             @default("flat")
  total                    Decimal            @db.Decimal(10, 2)
  shippingAddress          Json?              @default("{}")
  customerNotes            String?
  officeNotes              String?
  courierService           CourierService?
  courierConsignmentId     String?
  courierTrackingCode      String?
  courierStatus            String?
  assignedToId             String?
  assignedAt               DateTime?
  timeline                 Json?              @default("[]")
  packingLock              PackingLock?
  editLock                 OrderEditLock?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  guestName                String?
  guestPhone               String?
  paymentOptionType        PaymentOptionType? // FULL_PAYMENT | PARTIAL_PAYMENT | CASH_ON_DELIVERY
  paymentOption            PaymentOption?     @relation(fields: [paymentOptionType], references: [type])
  source                   OrderSource?       @default(ECOMMERCE)
  salesChannel             SalesChannel?
  sourcePlatform           String?
  sourceType               String?
  sourceEntity             String?
  posSessionId             String?
  idempotencyKey           String?            @unique
  posSession               PosSession?        @relation(fields: [posSessionId], references: [id])
  paymentStatus            PaymentStatus      @default(PAYMENT_PENDING)
  paymentProof             Json?              @default("{}")
  partialAmount            Decimal?           @db.Decimal(10, 2)
  viewToken                String?            @unique
  trackingSessionId        String?
  selectedShippingOptionId String?
  shippingChargeOverridden Boolean            @default(false)
  trashedAt                DateTime?

  customer       CustomerProfile?     @relation(fields: [customerId], references: [id])
  assignee       UserProfile?         @relation("OrderAssignee", fields: [assignedToId], references: [id])
  status         OrderStatus          @relation(fields: [statusId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  shipment       Shipment?
  dispatchLogs   CourierDispatchLog[]
  dispatches     Dispatch[]
  refunds        Refund[]
  couponUsages   CouponUsage[]
  referralLeads  ReferralLead[]
  stockCycles    OrderStockCycle[]
  stockTransfers StockTransfer[]
  orderAttribution    OrderAttribution?
  marketingAllocations MarketingCostAllocation[]
  commissionEarnings   CommissionEarning[]

  @@index([customerId])
  @@index([statusId])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([courierService])
  @@index([courierConsignmentId])
  @@index([courierTrackingCode])
  @@index([paymentOptionType])
  @@index([guestPhone])
  @@index([posSessionId])
  @@index([source])
  @@index([salesChannel])
  @@index([trackingSessionId])
  @@index([trashedAt])
}

model OrderItem {
  id                   String   @id @default(uuid())
  orderId              String
  productId            String?
  variantId            String?
  comboId              String?
  comboSelection       Json?
  quantity             Int      @default(1)
  price                Decimal  @db.Decimal(10, 2)
  costSnapshot         Decimal? @db.Decimal(10, 2)
  costType             String? // 'estimated' | 'actual'
  managedStockReserved Boolean  @default(false)
  managedStockDeducted Boolean  @default(false)
  sourceWarehouseId    String?
  createdAt            DateTime @default(now())

  order           Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product?                  @relation(fields: [productId], references: [id])
  variant         ProductVariant?           @relation(fields: [variantId], references: [id])
  combo           Combo?                    @relation(fields: [comboId], references: [id])
  sourceWarehouse Warehouse?                @relation(fields: [sourceWarehouseId], references: [id])
  comboComponents OrderItemComboComponent[]
  marketingCosts  ProductMarketingCost[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([comboId])
  @@index([sourceWarehouseId])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  gatewayCode       String // Links to PaymentGateway.code (e.g., 'bkash', 'nagad', 'bkash_pgw', 'cash')
  amount            Decimal       @db.Decimal(10, 2)
  transactionId     String?
  providerPaymentId String?       @unique // bKash paymentID, bound at initiation
  screenshot        String?
  status            PaymentStatus @default(PENDING)
  verifiedBy        String?
  verifiedAt        DateTime?
  notes             String?
  createdAt         DateTime      @default(now())

  order    Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  verifier UserProfile? @relation("VerifiedPayments", fields: [verifiedBy], references: [id])

  @@unique([transactionId, gatewayCode])
  @@index([orderId])
  @@index([gatewayCode])
  @@index([transactionId])
}

model CheckoutLead {
  id               String    @id @default(uuid())
  displayId        String?   @unique
  phone            String?
  name             String?
  email            String?
  address          Json?
  items            Json?
  payload          Json?
  paymentMethod    String?
  status           String    @default("PENDING")
  fingerprint      String?
  ctxId            String?
  occurrences      Int       @default(1)
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  assignedToId     String?
  assignedById     String?
  assignedAt       DateTime?
  convertedAt      DateTime?
  convertedById    String?
  convertedOrderId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  assignedTo  UserProfile? @relation("CheckoutLeadAssignedTo", fields: [assignedToId], references: [id])
  assignedBy  UserProfile? @relation("CheckoutLeadAssignedBy", fields: [assignedById], references: [id])
  convertedBy UserProfile? @relation("CheckoutLeadConvertedBy", fields: [convertedById], references: [id])

  @@index([phone])
  @@index([status])
  @@index([assignedToId])
  @@index([lastSeenAt])
  @@index([fingerprint])
  @@index([ctxId])
}

model Shipment {
  id         String   @id @default(uuid())
  orderId    String   @unique
  trackingNo String?
  courier    String?
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ShippingOption {
  id        String   @id @default(uuid())
  name      String
  amount    Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShippingZoneGroup {
  id        String   @id @default(uuid())
  label     String?
  type      String
  amount    Decimal? @db.Decimal(10, 2)
  districts Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  subject   String
  body      String   @db.Text
  variables Json?    @default("[]")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns EmailCampaign[]
}

enum CampaignStatus {
  draft
  scheduled
  sending
  sent
  cancelled
}

model EmailCampaign {
  id            String         @id @default(uuid())
  name          String
  subject       String
  templateId    String?
  content       String?        @db.Text
  recipients    Json?          @default("[]")
  segmentFilter Json?          @default("{}")
  scheduledAt   DateTime?
  sentAt        DateTime?
  status        CampaignStatus @default(draft)
  totalSent     Int            @default(0)
  totalFailed   Int            @default(0)
  createdBy     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  template EmailTemplate? @relation(fields: [templateId], references: [id])

  @@index([status])
  @@index([createdAt])
}

