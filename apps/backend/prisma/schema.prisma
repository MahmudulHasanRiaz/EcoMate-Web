// Persistent OAuth token store for courier merchant APIs (Pathao per the
// official integration guide: the issued access token "should be saved in the
// database (or any persistent store) for future use" and refreshed via the
// refresh_token grant instead of re-authenticating on every request).
model CourierAuthToken {
  courier      String   @id
  accessToken  String
  refreshToken String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum DispatchStatus {
  DISPATCHED
  HANDED_OVER
  PICKED_UP
  IN_TRANSIT
  ASSIGNED_TO_RIDER
  HOLD
  DELIVERED
  PARTIAL
  RETURN_PENDING
  RETURNED
  CANCELLED
}

model Dispatch {
  id              String         @id @default(uuid())
  orderId         String
  courier         CourierService
  consignmentId   String
  trackingCode    String?
  trackingUrl     String?
  status          DispatchStatus @default(DISPATCHED)
  // Raw running/current status verbatim from the courier (e.g. "delivered",
  // "order.in-transit"). Distinct from `status` (internal DispatchStatus):
  // persists the courier's own latest state even when webhooks are missed,
  // and is the source for the Dispatch list "Courier Status" column.
  courierStatus   String?
  courierStatusAt DateTime?
  /// Amount-to-collect sent to the courier at dispatch time. Source of truth
  /// for the post-dispatch COD mismatch comparison (Feature A).
  courierAmount   Decimal?  @db.Decimal(10, 2)
  lastSyncedAt    DateTime?
  handedOverAt    DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  productMapping  Json?          @default("[]")
  notes           String?
  flaggedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([courier, consignmentId])
  @@index([orderId])
  @@index([courier])
  @@index([status])
  @@index([courierStatus])
  @@index([lastSyncedAt])
  // Settlement matcher probes consignment/tracking WITHOUT a courier filter
  // (the composite unique's leading column can't serve those lookups).
  @@index([consignmentId])
  @@index([trackingCode])
}

enum WebhookAttemptOutcome {
  SUCCESS
  AUTH_FAILED
  AUTH_HEADER_MISSING
  AUTH_FORMAT_INVALID
  RATE_LIMITED
  PAYLOAD_INVALID
  ORDER_NOT_FOUND
  PROCESSING_ERROR
  SKIPPED
  UNKNOWN_ERROR
}

enum WebhookAttemptStage {
  RATE_LIMIT
  AUTH
  PAYLOAD
  ORDER_RESOLUTION
  PROCESSING
  RESPONSE
}

