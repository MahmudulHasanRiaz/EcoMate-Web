  shelf                                        Shelf?                                        @relation(fields: [shelfId], references: [id])
  products                                     Product[]                                     @relation("ProductDefaultBin")
  variants                                     ProductVariant[]                              @relation("VariantBin")
  physicalInventories                          PhysicalInventory[]
  reservationAllocations                       PhysicalReservationAllocation[]
  comboComponentPhysicalReservationAllocations ComboComponentPhysicalReservationAllocation[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@index([zoneId])
  @@index([rackId])
  @@index([shelfId])
}

model CostingLot {
  id                  String   @id @default(uuid())
  purchaseId          String?
  grnId               String?
  productId           String
  variantId           String?
  warehouseId         String
  lotNumber           String   @unique
  unitCost            Decimal  @db.Decimal(12, 2)
  totalCost           Decimal  @db.Decimal(14, 2)
  quantity            Int
  remainingQty        Int
  receivedAt          DateTime @default(now())
  createdAt           DateTime @default(now())
  transferId          String?
  sourceConsumptionId String?  @unique

  purchase                   Purchase?               @relation(fields: [purchaseId], references: [id])
  grn                        GoodsReceiptNote?       @relation(fields: [grnId], references: [id])
  warehouse                  Warehouse               @relation(fields: [warehouseId], references: [id])
  transfer                   StockTransfer?          @relation(fields: [transferId], references: [id])
  consumptions               CostingLotConsumption[]
  sourceConsumption          CostingLotConsumption?  @relation("TransferDestinationLot", fields: [sourceConsumptionId], references: [id])
  transferSourceConsumptions CostingLotConsumption[] @relation("TransferSourceLot")

  @@index([productId, variantId, warehouseId, remainingQty])
  @@index([purchaseId])
  @@index([warehouseId])
  @@index([transferId])
}

model CostingLotConsumption {
  id            String                    @id @default(uuid())
  costingLotId  String
  type          CostingLotConsumptionType
  quantity      Int
  unitCost      Decimal                   @db.Decimal(12, 2)
  referenceType String
  referenceId   String
  cycleId       String?
  createdAt     DateTime                  @default(now())

  costingLot      CostingLot              @relation(fields: [costingLotId], references: [id])
  restorations    CostingLotRestoration[]
  sourceLot       CostingLot?             @relation("TransferSourceLot", fields: [sourceLotId], references: [id])
  sourceLotId     String?
  createdLot      CostingLot?             @relation("TransferDestinationLot")
  orderStockCycle OrderStockCycle?        @relation(fields: [cycleId], references: [id])

  @@unique([referenceType, referenceId, costingLotId, type])
  @@index([costingLotId])
  @@index([referenceType, referenceId])
  @@index([sourceLotId])
  @@index([cycleId])
}

model CostingLotRestoration {
  id                String   @id @default(uuid())
  consumptionId     String
  returnReferenceId String
  cycleId           String?
  quantity          Int
  unitCost          Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now())

  consumption     CostingLotConsumption @relation(fields: [consumptionId], references: [id])
  orderStockCycle OrderStockCycle?      @relation(fields: [cycleId], references: [id])

  @@unique([consumptionId, returnReferenceId])
  @@index([consumptionId])
  @@index([returnReferenceId])
  @@index([cycleId])
}

model StockTransfer {
  id                String    @id @default(uuid())
  idempotencyKey    String    @unique
  sourceWarehouseId String
  destWarehouseId   String
  status            String    @default("REQUESTED")
  notes             String?   @db.Text
  performedBy       String?
  requestedBy       String?
  orderId           String?
  order             Order?    @relation(fields: [orderId], references: [id])
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  sourceWarehouse Warehouse           @relation("TransferSource", fields: [sourceWarehouseId], references: [id])
  destWarehouse   Warehouse           @relation("TransferDest", fields: [destWarehouseId], references: [id])
  destinationLots CostingLot[]
  items           StockTransferItem[]

  @@index([sourceWarehouseId])
  @@index([destWarehouseId])
  @@index([status])
  @@index([orderId])
}

// One row per product/variant requested by a transfer request (POS) or any
// other requester. The StockTransfer header carries source/destination and
// lifecycle status; this table answers "what exactly is being moved".
model StockTransferItem {
  id         String   @id @default(uuid())
  transferId String
  productId  String
  variantId  String?
  quantity   Int
  createdAt  DateTime @default(now())

  transfer StockTransfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: deleting a ProductVariant must not erase the record
  // of what was transferred. variantId is nullable, so the audit row survives
  // with the variant reference cleared.
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([transferId])
  @@index([productId])
}

model GoodsReceiptNote {
  id          String   @id @default(uuid())
  grnNumber   String   @unique
  purchaseId  String
  warehouseId String
  receivedBy  String?
  receivedAt  DateTime @default(now())
  status      String   @default("draft")
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  // Client-supplied idempotency key (Idempotency-Key header). Replay with
  // the same key returns the original GRN instead of double-posting stock.
  clientKey   String?  @unique

  purchase    Purchase               @relation(fields: [purchaseId], references: [id])
  warehouse   Warehouse              @relation(fields: [warehouseId], references: [id])
  items       GoodsReceiptNoteItem[]
  costingLots CostingLot[]
}

model GoodsReceiptNoteItem {
  id             String  @id @default(uuid())
  grnId          String
  purchaseItemId String?
  productId      String
  variantId      String?
  expectedQty    Int
  receivedQty    Int
  acceptedQty    Int
  rejectedQty    Int     @default(0)
  unitCost       Decimal @db.Decimal(12, 2)
  totalCost      Decimal @db.Decimal(14, 2)
  // Who bears damage cost: 'supplier' (damage excluded from inventory value)
  // or 'company' (damage cost allocated onto the accepted units).
  damageResponsibility String  @default("supplier")
  // Supplier-sent free replacement: accepted into stock at zero cost.
  freeOfCharge Boolean @default(false)
  // Per-line receiving location; falls back to the GRN warehouse.
  lineWarehouseId String?

  grn GoodsReceiptNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
}

model SupplierPayment {
