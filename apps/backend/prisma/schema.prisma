model OrderStatusTransition {
  id              String    @id @default(uuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Canonical OrderStatus.name. Stored as text, not an enum: statuses are rows
  // in OrderStatus and an installation may add its own.
  fromStatus      String?
  toStatus        String    @map("toStatus")

  // Always a UserProfile.id (payload.sub) — the only actor identifier this
  // codebase can guarantee. System-driven transitions (webhooks, dispatch) use
  // a reserved constant.
  actorUserId     String?
  actorEmployeeId String?
  actorEmployee   Employee? @relation(fields: [actorEmployeeId], references: [id], onDelete: SetNull)
  actorType       String    @default("staff")

  // True for the earliest transition INTO toStatus for this order. Maintained
  // by the writer inside the same transaction, so "first actor" is a database
  // guarantee rather than an ordering accident when two transitions share a
  // timestamp.
  isFirstForStatus Boolean   @default(false)

  // Application-supplied idempotency key; a duplicate submit is a no-op.
  idempotencyKey  String?
  note            String?
  metadata        Json      @default("{}")

  // When the transition happened, per the application clock.
  occurredAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())

  commissionLedger CommissionLedgerV2[]

  @@index([orderId, occurredAt, id], map: "OrderStatusTransition_orderId_occurredAt_idx")
  @@index([orderId, toStatus, occurredAt, id], map: "OrderStatusTransition_orderId_toStatus_occurredAt_idx")
  @@index([actorEmployeeId, occurredAt], map: "OrderStatusTransition_actorEmployeeId_occurredAt_idx")
}

model CommissionRuleV2 {
  id         String               @id @default(uuid())
  employeeId String
  employee   Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  name       String?
  /// Canonical OrderStatus.name this rule pays for. Validated against
  /// OrderStatus by the API; never free text.
  purpose    String
  amountType CommissionAmountType
  amount     Decimal              @db.Decimal(10, 2)

  /// Which order figure a percentage applies to: order_total (canonical,
  /// matches every existing commission calculation) or subtotal.
  valueBasis String               @default("order_total")

  /// Optional per-order amount gate, carried over from v1 minOrderAmount.
  /// Distinct from the count threshold below.
  minOrderAmount Decimal?          @db.Decimal(10, 2)
  /// Optional ceiling for a single order's commission.
  capPerOrder    Decimal?          @db.Decimal(10, 2)

  /// NULL = no minimum: every qualifying order pays.
  minimumCount   Int?
  /// daily | weekly | monthly | yearly. NULL when minimumCount is NULL.
  thresholdPeriod String?

  effectiveFrom DateTime?
  effectiveTo   DateTime?

  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  ledger CommissionLedgerV2[]

  @@index([employeeId, isActive])
  @@index([employeeId, purpose, isActive])
}

model CommissionLedgerV2 {
  id         String            @id @default(uuid())
  employeeId String
  employee   Employee          @relation("EmployeeLedger", fields: [employeeId], references: [id], onDelete: Restrict)
  orderId    String
  order      Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  ruleId     String
  rule       CommissionRuleV2  @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  /// The status this credit is for.
  purpose String

  /// The transition that earned it. Ties money to the event.
  transitionId String
  transition   OrderStatusTransition @relation(fields: [transitionId], references: [id], onDelete: Restrict)
  actorEmployeeId String?
  actorEmployee   Employee? @relation("ActorLedger", fields: [actorEmployeeId], references: [id], onDelete: SetNull)
  qualifiedAt  DateTime

  /// Calculation snapshot. Historical earnings must not move when a rule is
  /// edited, so every input to the arithmetic is copied here at credit time.
  amountType   CommissionAmountType
  ruleAmount   Decimal        @db.Decimal(10, 2)
  valueBasis   String
  sourceAmount Decimal        @db.Decimal(10, 2)
  amount       Decimal        @db.Decimal(10, 2)
  capApplied   Boolean        @default(false)

  /// Threshold evidence: why this qualified, when it was gated.
  minimumCount         Int?
  thresholdPeriod      String?
  countAtQualification Int?

  /// Period bucket key (e.g. 2026-10-02 for daily) so reports and payroll do
  /// not recompute timezone maths per row.
  periodKey String

  status    LedgerStatus @default(approved)
  payslipId String?
  createdAt DateTime     @default(now())

  reversals CommissionReversalV2[]

  /// The idempotency guarantee: one credit per order per purpose, forever.
  /// A webhook retry, double-click or concurrent evaluation cannot produce two.
  @@unique([orderId, purpose], map: "CommissionLedgerV2_order_purpose_unique")
  @@index([employeeId, qualifiedAt])
  @@index([employeeId, purpose, qualifiedAt])
  @@index([payslipId, status, qualifiedAt])
  @@index([ruleId, qualifiedAt])
  @@index([periodKey], map: "CommissionLedgerV2_periodKey_idx")
}

model CommissionThresholdCounter {
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  purpose    String
  /// e.g. 2026-10-02 for daily, 2026-W41 for weekly, 2026-10 for monthly.
  periodKey  String
  count      Int      @default(0)
  lastQualifiedAt DateTime?
  updatedAt  DateTime @default(now()) @updatedAt

  /// The primary key IS the duplicate guard: re-processing an event cannot
  /// increment the same bucket twice.
  @@id([employeeId, purpose, periodKey])
  @@index([periodKey], map: "CommissionThresholdCounter_periodKey_idx")
}

model CommissionReversalV2 {
  id             String           @id @default(uuid())
  ledgerId       String
  ledger         CommissionLedgerV2 @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  orderId        String?
  amount         Decimal          @db.Decimal(10, 2)
  refundedAmount Decimal?         @db.Decimal(10, 2)
  reason         String
  reversedById   String?
  reversedAt     DateTime         @default(now())
  createdAt      DateTime         @default(now())

  @@unique([ledgerId, orderId], map: "CommissionReversalV2_ledger_order_unique")
  @@index([ledgerId], map: "CommissionReversalV2_ledgerId_idx")
}

model CommissionReversal {
  id                  String            @id @default(uuid())
  commissionEarningId String
  commissionEarning   CommissionEarning @relation(fields: [commissionEarningId], references: [id], onDelete: Cascade)
  orderId             String?
  amount              Decimal           @db.Decimal(10, 2)
  reason              String
  refundedAmount      Decimal?          @db.Decimal(10, 2)
  reversedById        String?
  reversedAt          DateTime          @default(now())
  createdAt           DateTime          @default(now())

  // Partial-unique (orderId non-null only) created in migration SQL.
  @@index([commissionEarningId])
}

// ── Courier Settlement & Invoice Management (PRD §5–§14) ──────────────────────
// Immutable raw preservation, normalization, reconciliation, finalization,
// authoritatively-written Order.shippingCost (§7), and accounting linkage (§8/§16).

enum CourierSettlementInvoiceState {
  UPLOADED
  ANALYZED
  MAPPING_REQUIRED
  IMPORTING
  READY_FOR_REVIEW
  REVIEW_REQUIRED
  ISSUE_FOUND
  FINALIZING
  FINALIZED_PENDING_ACCOUNTING
  ACCOUNTING_POSTED
  ACCOUNTING_SKIPPED_ACCOUNTING_DISABLED
  ACCOUNTING_FAILED
  ADJUSTED
  RECONCILED
  DISCARDED
  SUPERSEDED_BY_REVISION
}

enum CourierSettlementRowClass {
  DATA
  SUMMARY
  FOOTER
  UNKNOWN
}

enum CourierSettlementRowKind {
  DELIVERY
  RETURN
  FEE_ONLY
  BILLING_ONLY
  ADJUSTMENT
  SUMMARY
  FOOTER
  UNKNOWN
}

enum CourierSettlementMatchMethod {
  BY_CONSIGNMENT
  BY_TRACKING
  BY_ORDER_DISPLAYID
  BY_ORDER_EXTERNALID
  BY_ORDER_CUSTOMER
  MANUAL
  /// matchedBy is NULL and row could not be resolved (RED NO_MATCH)
  NONE
}

enum CourierSettlementAccountingStatus {
  PENDING
  POSTED
  SKIPPED_ACCOUNTING_DISABLED
  FAILED
}

enum CourierSettlementActivityAction {
  IMPORTED
  MAPPED
  MATCHED
  FINALIZED
  SNAPSHOT_TAKEN
  POSTED_ACCOUNTING
  ACCOUNTING_REPAIRED
  ADJUSTED
  REVISED
  REVISION_LINKED
  SUPERSEDED_BY_REVISION
  EFFECTIVE_STATE_CHANGED
  ACKNOWLEDGED
  DISCARDED
}

enum CourierSettlementAliasOrigin {
  SYSTEM
  LEARNED
  MANUAL
}

model CourierSettlementInvoice {
  id          String   @id @default(uuid())
  displayId   String   @unique
  courier     String
  provider    String?
  invoiceNo   String?
  invoiceDate DateTime
  rowCount    Int      @default(0)

  // Immutable source reference (§9 ①): original bytes preserved by StorageService,
  // never overwritten. Only derived fields change afterwards.
  fileStorageId    String?
  fileOriginalName String?
  fileSha256       String?
  fileMime         String?
  fileSize         Int?

  // Provider totals read from the file footer / structure (informational only).
  rawTotals       Json?
  // Original file header order (§3/§18): Postgres jsonb re-serializes keys
  // (length-then-byte order), so rawJson alone cannot reproduce the source
  // column order. The imported sheet takes its column order from this array.
  sourceHeaders   Json?
  // Current effective totals: { collected, charges, net, residual, cashReceived, cashDisbursed }.
  effectiveTotals Json?

  // §14 revision semantics: a revised invoice is a correction of a previous invoice,
  // not a second settlement. historical (snapshot) vs current (effective).
  isRevision          Boolean @default(false)
  revisionOfId        String?
  supersedesInvoiceId String?

  state               CourierSettlementInvoiceState @default(UPLOADED)
  // §17 background import (async commit above threshold): stage + 0-100 progress,
  // polled by the admin while state == IMPORTING.
  importProgress      Int                           @default(0)
  importStage         String?
  finalizingToken     String?
  finalizingStartedAt DateTime?
  finalizedAt         DateTime?
  finalizedBy         String?

  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  accountingStatus      CourierSettlementAccountingStatus @default(PENDING)
  accountingError       String?
  accountingAttemptedAt DateTime?
  accountingAttemptedBy String?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rows        CourierSettlementRow[]
  exceptions  CourierSettlementException[]
  activities  CourierSettlementActivity[]
  adjustments CourierSettlementAdjustment[]
  snapshots   CourierSettlementFinalizationSnapshot[]
  revisions   CourierSettlementInvoice[]              @relation("InvoiceRevisionHistory")
  revisedFrom CourierSettlementInvoice?               @relation("InvoiceRevisionHistory", fields: [revisionOfId], references: [id])

  @@index([state])
  @@index([courier])
  @@index([finalizedAt])
  @@index([displayId])
  // Upload duplicate check (sha256 probed on every analyze) + list ordering
  // (state filter + createdAt sort, and unfiltered createdAt sort).
  @@index([fileSha256])
  @@index([createdAt])
  @@index([state, createdAt])
}

model CourierSettlementRow {
  id        String                    @id @default(uuid())
  invoiceId String
  rowNumber Int
  rowClass  CourierSettlementRowClass
  rowKind   CourierSettlementRowKind

  consignmentId String?
  orderId       String?
  dispatchId    String?
  identifier    String?

  // Declared (provider) values, plus the effective value after adjustments (§9 ④).
  declaredCollected  Decimal @default(0) @db.Decimal(14, 2)
  declaredCharges    Decimal @default(0) @db.Decimal(14, 2)
  declaredNet        Decimal @default(0) @db.Decimal(14, 2)
  declaredResidual   Decimal @default(0) @db.Decimal(14, 2)
  effectiveCollected Decimal @default(0) @db.Decimal(14, 2)
  effectiveCharges   Decimal @default(0) @db.Decimal(14, 2)
  effectiveNet       Decimal @default(0) @db.Decimal(14, 2)
  effectiveResidual  Decimal @default(0) @db.Decimal(14, 2)

  matchMethod  String
  matchedAt    DateTime?
  /// { provider, confidence, orderSource, ... } — recorded for transparency
  matchContext Json?

  // (§9) ① raw ② normalized ③ adjustment(s) ④ effective. Only ④ feeds finance.
  rawJson       Json?
  normalized    Json?
  hasAdjustment Boolean @default(false)

  /// 'green' | 'yellow' | 'red' — derived from §15 ruleset, materialised for reads.
  reviewState String @default("green")

  // §14 revision semantics: when a later revision supersedes this row, the row
  // stops contributing to EVERY current aggregate but its raw/declared/effective
  // values and the finalization snapshot remain immutable history.
  supersededByRowId     String?
  supersededByInvoiceId String?
  supersededAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice     CourierSettlementInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  order       Order?                        @relation(fields: [orderId], references: [id])
  exceptions  CourierSettlementException[]
  adjustments CourierSettlementAdjustment[]

  @@unique([invoiceId, rowNumber])
  @@index([invoiceId])
  @@index([orderId])
  @@index([consignmentId])
  @@index([reviewState])
  @@index([supersededByRowId])
  @@index([supersededByInvoiceId])
  // Flow/invariant aggregates (rowClass=DATA + not superseded) and the
  // reconciliation queue group-by (invoiceId + matchMethod).
  @@index([rowClass, supersededByRowId])
  @@index([invoiceId, matchMethod])
  // Previous-settlement lookup scans superseded rows by supersededAt.
  @@index([supersededAt])
}

model CourierSettlementException {
  id         String    @id @default(uuid())
  invoiceId  String
  rowId      String?
  orderId    String?
  dispatchId String?
  ruleId     String
  severity   String    @default("yellow") // 'red' | 'yellow'
  status     String    @default("open") // 'open' | 'acknowledged' | 'resolved'
  blocked    Boolean   @default(false) // true when the row rule blocks finalization
  message    String?
  context    Json?
  resolvedAt DateTime?
  resolvedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice CourierSettlementInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  row     CourierSettlementRow?    @relation(fields: [rowId], references: [id])
  order   Order?                   @relation(fields: [orderId], references: [id])

  @@index([invoiceId])
  @@index([rowId])
  @@index([orderId])
  @@index([status])
  @@index([severity])
  // Detail timeline (invoice + createdAt sort) + queue filter (severity+status).
  @@index([invoiceId, createdAt])
  @@index([severity, status])
}

model CourierSettlementAdjustment {
  id              String   @id @default(uuid())
  invoiceId       String
  rowId           String?
  orderId         String?
  /// §8.1: 'source' | 'cost' | 'settlement'
  adjustmentClass String
  field           String // canonical column name being adjusted
  originalValue   String?
  adjustedValue   String?
  difference      Decimal? @db.Decimal(14, 2)
  reason          String?
  /// §8.2 counterpart: 'net' | 'gross' | 'variance' (required when ΔR ≠ 0)
  counterpart     String?
  userId          String?
  journalEntryId  String?  @unique // the compensating entry produced by this adjustment
  createdAt       DateTime @default(now())

  /// a reversal points back to the adjustment it reverses (original preserved)
  reversalOfId String? @unique
  reversedById String?

  invoice CourierSettlementInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  row     CourierSettlementRow?    @relation(fields: [rowId], references: [id])
  order   Order?                   @relation(fields: [orderId], references: [id])

  @@index([invoiceId])
  @@index([rowId])
  @@index([invoiceId, field])
}

model CourierSettlementActivity {
  id        String                          @id @default(uuid())
  invoiceId String
  action    CourierSettlementActivityAction
  actor     String?
  timestamp DateTime                        @default(now())
  /// arbitrary detail kept immutable: { before, after, reason, journalEntryId, ... }
  detail    Json?
  /// idempotency key (§6): @@unique([invoiceId, action, dedupeKey])
  dedupeKey String?

  invoice CourierSettlementInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, action, dedupeKey])
  @@index([invoiceId])
  @@index([timestamp])
  // Timeline reads are always invoice-scoped + time-sorted.
  @@index([invoiceId, timestamp])
}

/// Learned/seeded header → canonical field mapping. Ambiguous mappings stay inactive
/// (§12) and never propagate silently.
model CourierSettlementColumnAlias {
  id               String                       @id @default(uuid())
  courier          String
  sourceHeader     String
  normalizedHeader String
  field            String
  confidence       Decimal                      @default(0.0) @db.Decimal(5, 2)
  origin           CourierSettlementAliasOrigin @default(LEARNED)
  ambiguityCount   Int                          @default(0)
  active           Boolean                      @default(false)
  createdBy        String?
  lastUsedAt       DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@unique([courier, sourceHeader])
  @@index([courier])
  // Rival-active check probes (courier, field, active).
  @@index([courier, field])
  @@index([active])
}

/// Immutable point-in-time financial picture at the moment of finalization (§14.2).
/// Reconstructible forever; never updated or deleted by any service path (test-enforced).
model CourierSettlementFinalizationSnapshot {
  id             String   @id @default(uuid())
  invoiceId      String
  version        Int
  takenAt        DateTime @default(now())
  takenById      String?
  journalEntryId String?  @unique
  reason         String?
  /// invoice-level figures exactly as finalised: { collected, charges, net, residual, cashReceived, cashDisbursed }
  totals         Json
  /// per-row: identity + normalized + effective figures + match info + row state
  rows           Json

  invoice CourierSettlementInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, version])
  @@index([invoiceId])
}

/// Declarative finance rule per courier/format. §11: generic/unproven providers must not
/// finalize without approvedById set (approved rule). No formula is ever evaluated.
model CourierSettlementFinanceRule {
  id                String  @id @default(uuid())
  courier           String
  format            String?
  /// whitelist: 'declared_field' | 'collected_minus_charges' | 'billing_when_no_collection' | 'component_sum'
  netRule           String
  /// ordered [{ header, field, sign }] — signs multiply the parsed header value
  chargeComponents  Json
  residualThreshold Decimal @default(100.0) @db.Decimal(12, 2)
  tolerance         Decimal @default(1.0) @db.Decimal(12, 2)
  /// ordered candidate columns used to resolve an Order, e.g. ["consignmentId","trackingCode",...]
  identifierOrder   Json
  isPrecedence      Int     @default(0)

  /// §12 rule governance: every approval bumps the version; the superseded
  /// configuration is archived to CourierSettlementFinanceRuleVersion, so a
  /// finalized invoice's rule version stays reconstructible.
  version Int     @default(1)
  note    String?

  approved     Boolean   @default(false)
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions CourierSettlementFinanceRuleVersion[]

  @@unique([courier, format])
  @@index([courier])
  @@index([approved])
}

/// Superseded finance-rule configuration (versions 1..n-1; current lives on the rule).
model CourierSettlementFinanceRuleVersion {
  id           String    @id @default(uuid())
  ruleId       String
  version      Int
  /// Full configuration snapshot: { netRule, chargeComponents, residualThreshold,
  /// tolerance, identifierOrder, format, note }
  snapshot     Json
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())

  rule CourierSettlementFinanceRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, version])
  @@index([ruleId])
}
