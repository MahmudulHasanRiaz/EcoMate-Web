generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  inactive
  invited
  suspended
}

enum UserRole {
  superadmin
  admin
  cashier
  packing_assistant
  customer
  employee
}

enum AvailabilityMode {
  ALWAYS_IN_STOCK
  ALWAYS_OUT_OF_STOCK
  MANAGED_STOCK
  INVENTORY_CONTROLLED
}

enum TaskStatus {
  backlog
  todo
  in_progress @map("in progress")
  done
  canceled
}

enum TaskLabel {
  bug
  feature
  documentation
}

enum TaskPriority {
  low
  medium
  high
  critical
}

enum TaskTimeEntryStatus {
  active
  paused
  completed
}

enum PaymentOptionType {
  FULL_PAYMENT
  PARTIAL_PAYMENT
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PAYMENT_PENDING
  PENDING
  PAID
  PARTIAL_PAID
  PARTIAL_REFUNDED
  UNPAID
  FAILED
  CANCELLED
  REFUNDED
  PAYMENT_VERIFYING
}

enum WarehouseType {
  main
  showroom
  storage
}

enum CostingLotConsumptionType {
  FULFILLMENT
  ADJUSTMENT
  TRANSFER_OUT
}

enum OrderSource {
  POS
  ECOMMERCE
  MANUAL
}

/// Order kind: SALE = normal customer sale; RETURN = RTN return transaction
/// derived from a Partial original order (never a sale, never counted in
/// revenue/analytics/marketing attribution); EXCHANGE = replacement sale
/// raised against an existing order.
enum OrderKind {
  SALE
  RETURN
  EXCHANGE
}

enum SalesChannel {
  CALL
  FACEBOOK
  INSTAGRAM
  TIKTOK
  MESSENGER
  WHATSAPP
  THREADS
  WALK_IN
  WEBSITE
  OFFLINE
  POS
  OTHER
}

// ── Canonical sales-attribution dimensions ─────────────────────────────
// These four are INDEPENDENT facts and are never synonyms:
//   Channel         where the sale happened   WEBSITE | MESSAGING | PHONE_CALL | POS
//   ChannelEntity   that venue's specific origin (website.com | Page 1 | Office | Showroom)
//   Source          marketing platform        facebook | google | tiktok | …
//   AcquisitionType PAID | ORGANIC | UNKNOWN | NULL
//
// Example: WEBSITE | website.com | Facebook | PAID — Channel≠Source, Source≠Acquisition.
//
// The legacy SalesChannel enum above stays in place and is never renamed:
// it mixed venue, platform and contact modality into one field, which is
// exactly what these four dimensions separate. See sales-channel.mapper.ts
// for the deterministic legacy → canonical mapping.
enum SalesChannelV2 {
  WEBSITE
  MESSAGING
  PHONE_CALL
  POS
}

// PAID    — explicit paid evidence (sourceType=AD / paid utm medium on an ad platform)
// ORGANIC — a KNOWN referrer platform brought this, unpaid
// UNKNOWN — classification was attempted but could not be determined reliably
//
// NULL is NOT an enum value: "not applicable / not captured" is stored as a
// database NULL, which is semantically different from UNKNOWN.
//
// DIRECT is deliberately NOT an acquisition type. "No marketing referrer" is
// a SOURCE (the `direct` source slug), not an acquisition classification.
enum AcquisitionType {
  PAID
  ORGANIC
  UNKNOWN
}

model UserProfile {
  id                  String     @id @default(uuid())
  firstName           String
  lastName            String
  username            String     @unique
  email               String     @unique
  phoneNumber         String
  password            String
  emailVerified       Boolean    @default(false)
  failedLoginAttempts Int        @default(0)
  lockoutUntil        DateTime?
  lastIp              String?
  betterAuthUserId    String?    @unique
  status              UserStatus @default(active)
  role                UserRole   @default(admin)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  tasks                   Task[]
  settings                UserSettings?
  refreshTokens           RefreshToken[]
  addresses               Address[]
  assignedOrders          Order[]             @relation("OrderAssignee")
  payments                Payment[]           @relation("VerifiedPayments")
  refunds                 Refund[]            @relation("RefundProcessor")
  assignedLeads           CheckoutLead[]      @relation("CheckoutLeadAssignedTo")
  assignedByMe            CheckoutLead[]      @relation("CheckoutLeadAssignedBy")
  convertedLeads          CheckoutLead[]      @relation("CheckoutLeadConvertedBy")
  referrals               Referral[]
  posSessions             PosSession[]
  employmentHistory       EmploymentHistory[] @relation("EmploymentChangedBy")
  weeklyOffsCreated       WeeklyOff[]         @relation("WeeklyOffCreatedBy")
  shiftAssignmentsCreated ShiftAssignment[]   @relation("ShiftAssignmentCreatedBy")
  packingLocks            PackingLock[]
  orderEditLocks          OrderEditLock[]

  @@index([role])
  @@index([status])
  @@index([phoneNumber])
  @@map("User")
}

model betterAuthUser {
  id                   String   @id @default(cuid())
  name                 String
  email                String   @unique
  emailVerified        Boolean  @default(false)
  image                String?
  role                 String?  @default("customer")
  override_permissions String[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  accounts        betterAuthAccount[]
  sessions        betterAuthSession[]
  customerProfile CustomerProfile?
  employee        Employee?

  @@map("better_auth_users")
}

model betterAuthSession {
  id        String         @id @default(cuid())
  token     String         @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      betterAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model betterAuthAccount {
  id                    String         @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  user                  betterAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model betterAuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model VerificationToken {
  id        String    @id @default(uuid())
  email     String
  token     String
  type      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, type])
  @@index([token, type])
}

model AccessPreset {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @db.Text
  permissions String[]
  /// Seeded, admin-facing templates that ship with the product. Marked so the
  /// preset editor can protect them from deletion and renaming.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]
}

model AuthSettings {
  id           String   @id @default(uuid())
  providerName String   @unique
  isEnabled    Boolean  @default(false)
  clientId     String
  clientSecret String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("auth_settings")
}

model CustomerProfile {
  id               String   @id @default(uuid())
  betterAuthUserId String?  @unique
  externalId       String?  @unique
  phone            String   @unique
  email            String?
  name             String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Latest-order telemetry only — operational, NOT part of the canonical
  // identity above. Distinct from UserProfile.lastIp (staff auth telemetry).
  // Maintained as the MAX(Order.createdAt) for this customer; the write is a
  // conditional update whose WHERE clause carries the max-semantics, so an
  // older order committing late can never clobber a newer order's values.
  // Never written by a profile edit, and never derived from an order snapshot.
  lastOrderIp String?
  lastOrderAt DateTime?

  betterAuthUser    betterAuthUser?   @relation(fields: [betterAuthUserId], references: [id], onDelete: SetNull)
  orders            Order[]
  addresses         Address[]
  // Customer-owned, reusable address book. Independent from Order.shippingAddress
  // / Order.billingAddress, which are order-owned historical snapshots.
  customerAddresses CustomerAddress[]
  // Every phone number ever linked to this customer (primary + secondaries
  // from staff-entered orders). `phone` is globally unique: one number belongs
  // to exactly one customer, which is what makes "type any linked number →
  // same customer" safe. No auto-merge ever happens through this table.
  linkedPhones CustomerPhone[]

  creditEntries CustomerCreditEntry[]

  @@index([email])
  // Orders-list search matches customer name as a substring.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "CustomerProfile_name_trgm_idx")
}

// One row per phone number linked to a customer. The primary number mirrors
// CustomerProfile.phone; secondaries arrive from staff-entered orders
// (Order.secondaryPhone). `phone` is globally UNIQUE on purpose: a number can
// only ever resolve to one customer, so cross-customer collisions are refused
// at link time instead of silently merging two identities.
model CustomerPhone {
  id                String          @id @default(uuid())
  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  phone             String          @unique
  // 'primary' | 'secondary' — where the link came from.
  source            String          @default("secondary")
  createdAt         DateTime        @default(now())

  @@index([customerProfileId])
}

model Task {
  id                 String          @id @default(uuid())
  displayId          String          @unique
  title              String
  status             TaskStatus      @default(todo)
  label              TaskLabel       @default(feature)
  priority           TaskPriority    @default(medium)
  assignee           String?
  assignedEmployeeId String?
  description        String?
  dueDate            DateTime?
  estimatedMinutes   Int?
  actualMinutes      Int             @default(0)
  createdById        String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  createdBy        UserProfile     @relation(fields: [createdById], references: [id])
  assignedEmployee Employee?       @relation("EmployeeAssignedTasks", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  timeEntries      TaskTimeEntry[]

  @@index([createdById])
  @@index([assignee])
  @@index([assignedEmployeeId])
  @@index([status])
}

model TaskTimeEntry {
  id          String              @id @default(uuid())
  taskId      String
  task        Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startedAt   DateTime            @default(now())
  endedAt     DateTime?
  durationSec Int                 @default(0)
  status      TaskTimeEntryStatus @default(completed)
  notes       String?
  source      String              @default("manual")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([taskId])
  @@index([employeeId])
  @@index([startedAt])
  @@index([employeeId, startedAt])
  @@index([employeeId, startedAt, status])
  // A partial unique index (migration-only) enforces one running timer per
  // task+employee; Prisma cannot express the WHERE clause, so it lives in SQL.
  @@index([taskId, employeeId])
}

model UserSettings {
  id     String @id @default(uuid())
  userId String @unique

  theme                          String   @default("light")
  font                           String   @default("inter")
  username                       String?
  email                          String?
  bio                            String?
  urls                           String?
  accountName                    String?
  accountDob                     String?
  accountLanguage                String?
  notificationType               String   @default("all")
  notificationMobile             Boolean  @default(false)
  notificationCommunicationEmail Boolean  @default(false)
  notificationSocialEmail        Boolean  @default(false)
  notificationMarketingEmail     Boolean  @default(false)
  notificationSecurityEmail      Boolean  @default(true)
  displayItems                   String?
  autoVariantSelect              Boolean  @default(true)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id          String   @id @default(uuid())
  userId      String?
  label       String // "Home", "Office", etc.
  fullName    String
  phoneNumber String
  street      String
  city        String
  state       String?
  zipCode     String?
  country     String   @default("Bangladesh")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user              UserProfile?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerProfileId String?
  customerProfile   CustomerProfile? @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([customerProfileId])
  @@index([userId, isDefault, createdAt])
}

// ── Customer-owned address book ──────────────────────────────
// Reusable, current customer truth. Deliberately SEPARATE from the legacy
// `Address` model above, which is flat (street/city/state/zipCode), dual-owned
// by UserProfile OR CustomerProfile, has no role distinction, and is never
// written by the order flow. This model carries the BD locality shape orders
// actually store and is written only by the order-time sync service.
enum CustomerAddressType {
  SHIPPING
  BILLING
}

model CustomerAddress {
  id                String          @id @default(uuid())
  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  // ROLE, not a duplicate marker: one physical address may legitimately exist
  // as both a SHIPPING and a BILLING record with identical contents. Billing and
  // shipping are separate business roles with separate lifecycles, so collapsing
  // them would destroy the distinction and make a role change destructive.
  type      CustomerAddressType @default(SHIPPING)
  label     String?
  isDefault Boolean             @default(false)

  fullName    String
  phone       String
  addressLine String
  area        String?
  thana       String?
  district    String?
  division    String?
  postalCode  String?
  country     String  @default("Bangladesh")

  // sha256 over normalized fullName|phone|addressLine|area|thana|district|
  // postalCode|country. Matches only WITHIN the same `type` — thana/district
  // alone can never identify an address, so a different house/road in the same
  // locality hashes differently and becomes its own row. NULL disables dedup
  // for this row rather than colliding (Postgres NULLs never conflict).
  normalizedHash String?

  // Audit only — the order that first introduced this address. Never a relation:
  // deleting an order must not cascade into the customer's address book.
  sourceOrderId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([customerProfileId, type, normalizedHash])
  @@index([customerProfileId, type])
  @@index([customerProfileId, isDefault])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  parentId      String?
  image         String?
  sortOrder     Int      @default(0)
  showInMenu    Boolean  @default(true)
  menuSortOrder Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent            Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children          Category[]        @relation("CategoryTree")
  products          Product[]         @relation("ProductCategory")
  productCategories ProductCategory[]
  combos            Combo[]
  sizeChartId       String?
  sizeChart         SizeChart?        @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model Brand {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logo      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[] @relation("ProductBrand")
}

model Attribute {
  id        String           @id @default(uuid())
  name      String           @unique
  swatchFit String?
  values    AttributeValue[]
  createdAt DateTime         @default(now())
}

model AttributeValue {
  id          String  @id @default(uuid())
  value       String
  hexCode     String?
  image       String?
  attributeId String
  sortOrder   Int     @default(0)

  attribute Attribute                      @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants  ProductVariantAttributeValue[]
}

model Product {
  id                   String           @id @default(uuid())
  name                 String
  slug                 String           @unique
  type                 String           @default("simple")
  description          String?          @db.Text
  shortDesc            String?          @db.Text
  basePrice            Decimal          @db.Decimal(10, 2)
  salePrice            Decimal?         @db.Decimal(10, 2)
  sku                  String?
  managedStockQuantity Int              @default(0) @map("stock")
  lowStockQty          Int?
  availabilityMode     AvailabilityMode @default(MANAGED_STOCK)
  standardCost         Decimal?         @db.Decimal(10, 2)
  categoryId           String?
  tags                 Json?            @default("[]")
  images               Json?            @default("[]")
  seoMeta              Json?            @default("{}")
  isFeatured           Boolean          @default(false)
  isActive             Boolean          @default(true)
  status               String           @default("active")
  manageStock          Boolean          @default(false)
  syncManagedStock     Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  brandId                  String?
  brand                    Brand?                    @relation("ProductBrand", fields: [brandId], references: [id], onDelete: SetNull)
  reservedStock            Int                       @default(0)
  warehouseId              String?
  defaultBinLocationId     String?
  warehouse                Warehouse?                @relation(fields: [warehouseId], references: [id])
  defaultBinLocation       BinLocation?              @relation("ProductDefaultBin", fields: [defaultBinLocationId], references: [id])
  category                 Category?                 @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  productCategories        ProductCategory[]
  productTags              ProductTag[]
  variants                 ProductVariant[]
  orderItems               OrderItem[]
  comboItems               ComboItem[]
  sizeChartId              String?
  sizeChart                SizeChart?                @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  videoUrl                 String?
  detailRows               Json?
  descriptionSections      Json?
  reviews                  Review[]
  paymentOptionOverrides   ProductPaymentOption[]
  purchaseItems            PurchaseItem[]
  physicalInventories      PhysicalInventory[]
  physicalLedgers          PhysicalInventoryLedger[]
  physicalReservations     PhysicalReservation[]
  orderItemComboComponents OrderItemComboComponent[]
  transferItems            StockTransferItem[]

  @@index([isActive])
  @@index([categoryId])
  @@index([createdAt])
  @@index([sku])
  @@index([type])
  @@index([brandId])
  // Substring SKU search on the orders list (trigram).
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_sku_trgm_idx")
  // Substring name/slug search on the product list (`contains`, leading
  // wildcard) — without these every keystroke is a sequential scan at
  // thousands scale.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_trgm_idx")
  @@index([slug(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_slug_trgm_idx")
}

model ProductVariant {
  id                   String   @id @default(uuid())
  productId            String
  sku                  String   @unique
  sortOrder            Int      @default(0)
  price                Decimal? @db.Decimal(10, 2)
  salePrice            Decimal? @db.Decimal(10, 2)
  managedStockQuantity Int      @default(0) @map("stock")
  standardCost         Decimal? @db.Decimal(10, 2)
  image                String?
  images               Json?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  product             Product                        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues     ProductVariantAttributeValue[]
  orderItems          OrderItem[]
  comboItems          ComboItem[]
  purchaseItems       PurchaseItem[]
  reservedStock       Int                            @default(0)
  warehouseId         String?
  binLocationId       String?
  warehouse           Warehouse?                     @relation(fields: [warehouseId], references: [id])
  binLocation         BinLocation?                   @relation("VariantBin", fields: [binLocationId], references: [id])
  physicalInventories PhysicalInventory[]
  physicalLedgers     PhysicalInventoryLedger[]
  transferItems       StockTransferItem[]

  @@index([productId])
  // Substring SKU search on the orders list (trigram).
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "ProductVariant_sku_trgm_idx")
}

model ProductVariantAttributeValue {
  id               String @id @default(uuid())
  variantId        String
  attributeValueId String

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, attributeValueId])
}

model Combo {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  shortDesc   String?   @db.Text
  basePrice   Decimal   @db.Decimal(10, 2)
  salePrice   Decimal?  @db.Decimal(10, 2)
  image       String?
  images      Json?     @default("[]")
  categoryId  String?
  tags        Json?     @default("[]")
  seoMeta     Json?     @default("{}")
  isFeatured  Boolean   @default(false)
  isActive    Boolean   @default(true)
  manageStock Boolean   @default(false)
  stock       Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category               Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items                  ComboItem[]
  orderItems             OrderItem[]
  paymentOptionOverrides ProductPaymentOption[]
  reservedStock          Int                    @default(0)
  warehouseId            String?
  warehouse              Warehouse?             @relation(fields: [warehouseId], references: [id])

  @@index([isActive])
}

model ComboItem {
  id        String   @id @default(uuid())
  comboId   String
  productId String
  variantId String?
  quantity  Int      @default(1)
  price     Decimal? @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  combo   Combo           @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([comboId, productId, variantId])
}

enum PosSessionStatus {
  open
  closed
  cancelled
}

model PosSession {
  id              String           @id @default(uuid())
  showroomId      String
  showroom        Warehouse        @relation(fields: [showroomId], references: [id])
  cashierId       String
  cashier         UserProfile      @relation(fields: [cashierId], references: [id])
  openingBalance  Decimal          @db.Decimal(10, 2)
  closingBalance  Decimal?         @db.Decimal(10, 2)
  expectedBalance Decimal?         @db.Decimal(10, 2)
  status          PosSessionStatus @default(open)
  openedAt        DateTime         @default(now())
  closedAt        DateTime?
  notes           String?
  orders          Order[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([showroomId])
  @@index([cashierId])
  @@index([status])
}

model PackingLock {
  id        String      @id @default(uuid())
  orderId   String      @unique
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  packerId  String
  packer    UserProfile @relation(fields: [packerId], references: [id])
  startedAt DateTime    @default(now())
  expiresAt DateTime?

  @@index([packerId])
}

model OrderEditLock {
  id          String      @id @default(uuid())
  orderId     String      @unique
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId      String
  user        UserProfile @relation(fields: [userId], references: [id])
  acquiredAt  DateTime    @default(now())
  heartbeatAt DateTime    @default(now())
  expiresAt   DateTime

  @@index([userId])
  @@index([expiresAt])
}

model OrderStatus {
  id           String   @id @default(uuid())
  name         String   @unique
  color        String   @default("#6B7280")
  nextStatuses Json?    @default("[]")
  isInitial    Boolean  @default(false)
  isFinal      Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  orders          Order[]
  commissionRules CommissionRule[]
}

model Order {
  id                       String             @id @default(uuid())
  displayId                String             @unique
  kind                     OrderKind          @default(SALE)
  /// Original sale order this RTN return order was created from.
  /// At most one OPEN (not yet returned) RTN per original — enforced by the
  /// partial unique index `Order_returnOfOrderId_open_key`. Once that RTN is
  /// Returned, the original may be split again, so this is deliberately NOT a
  /// plain unique constraint (one original may accumulate several RTNs).
  returnOfOrderId          String?
  /// Original order this EXCHANGE was raised against. One original may have
  /// MANY exchanges, so this is a plain index, never unique.
  exchangeOfOrderId        String?
  /// Set when the RTN order itself reached 'Returned' (stock restored).
  returnedAt               DateTime?
  /// Idempotency guard for RTN stock restoration: once true, the exact RTN
  /// quantities have been restored and must never be restored again.
  stockRestored            Boolean            @default(false)
  customerId               String?
  statusId                 String
  subtotal                 Decimal            @db.Decimal(10, 2)
  shippingCharge           Decimal            @default(0) @db.Decimal(10, 2)
  discount                 Decimal            @default(0) @db.Decimal(10, 2)
  discountType             String             @default("flat")
  total                    Decimal            @db.Decimal(10, 2)
  // ORDER-OWNED HISTORICAL ADDRESS SNAPSHOTS — independent from CustomerProfile
  // and from the customer's CustomerAddress book. Editing the customer's
  // address book NEVER changes these; editing one of these NEVER changes the
  // other. billingAddress is populated ONLY from data actually captured at
  // order time — it is never derived post-hoc from shippingAddress.
  shippingAddress          Json?              @default("{}")
  billingAddress           Json?              @default("{}")
  customerNotes            String?
  officeNotes              String?
  courierService           CourierService?
  courierConsignmentId     String?
  courierTrackingCode      String?
  courierStatus            String?
  assignedToId             String?
  assignedAt               DateTime?
  timeline                 Json?              @default("[]")
  packingLock              PackingLock?
  editLock                 OrderEditLock?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  guestName                String?
  guestPhone               String?
  // Optional second contact number for the order (staff-entered). Normalized
  // to the same canonical form as every other phone column. Linked to the
  // customer via CustomerPhone — never matched implicitly.
  secondaryPhone           String?
  // OWNERSHIP INVARIANT — order-owned historical truth, NOT immutable:
  //  - A new order builds its snapshot from that order's own captured values.
  //  - CustomerProfile NEVER overwrites these fields, directly or indirectly
  //    by changing itself. A profile change never alters a historical order.
  //  - Authorized staff MAY correct an order's snapshot explicitly (PUT
  //    /orders/:id customerInfo). That is a sanctioned mutation of order-owned
  //    data — the previous "MUST NEVER be updated" wording wrongly implied the
  //    correction was forbidden, and contradicted the code.
  //  - With updateCustomerProfile=true the profile write and the snapshot write
  //    are two SEPARATE ownership operations, each written independently.
  // All historical order display, Purchase tracking events, and print
  // templates MUST read these fields rather than the mutable CustomerProfile.
  customerEmail            String?
  customerPhone            String?
  customerFirstName        String?
  customerLastName         String?
  customerCity             String?
  customerState            String?
  customerZip              String?
  customerCountry          String?            @default("BD")
  paymentOptionType        PaymentOptionType? // FULL_PAYMENT | PARTIAL_PAYMENT | CASH_ON_DELIVERY
  paymentOption            PaymentOption?     @relation(fields: [paymentOptionType], references: [type])
  source                   OrderSource?       @default(ECOMMERCE)
  salesChannel             SalesChannel?
  sourcePlatform           String?
  sourceType               String?
  sourceEntity             String?
  // ── Canonical sales-attribution dimensions (additive; legacy above stays) ──
  // `source`/`salesChannel`/`sourcePlatform`/`sourceType`/`sourceEntity` are
  // NEVER renamed, dropped or rewritten by this model, so the previous
  // application version keeps working against a migrated database and a
  // post-cutover rollback is an application revert, not a schema revert.
  //
  // channel/sourceSlug/acquisitionType are INDEPENDENT dimensions: a Channel
  // never implies a Source, and neither ever implies an AcquisitionType.
  channel                  SalesChannelV2?
  channelEntity            String?
  sourceSlug               String?
  acquisitionType          AcquisitionType?
  /// MIGRATION MARKER — NOT business data. Distinguishes "canonical mapping
  /// has not run yet" from "it ran and the answer is genuinely NULL". This
  /// is why the backfill can never use `channel IS NULL` as its guard: for 278
  /// historical orders a NULL channel is the CORRECT answer. Excluded from
  /// API responses and UI.
  channelMappedAt          DateTime?
  sourcePlatformRef        SourcePlatform?    @relation(fields: [sourceSlug], references: [slug])
  posSessionId             String?
  idempotencyKey           String?            @unique
  posSession               PosSession?        @relation(fields: [posSessionId], references: [id])
  paymentStatus            PaymentStatus      @default(PAYMENT_PENDING)
  paymentProof             Json?              @default("{}")
  partialAmount            Decimal?           @db.Decimal(10, 2)
  viewToken                String?            @unique
  trackingSessionId        String?
  selectedShippingOptionId String?
  shippingChargeOverridden Boolean            @default(false)
  /// Actual fulfillment/courier cost (BDT). NULL = not recorded.
  shippingCost             Decimal?           @db.Decimal(10, 2)
  /// 'manual' | 'courier_default' | 'courier_invoice' — source of the actual courier cost.
  /// 'courier_invoice' is written by Courier Settlement finalization (§7, authoritative incl. when 0).
  shippingCostSource       String?
  trashedAt                DateTime?

  // ── Exchange settlement (kind = EXCHANGE only; NULL for every other order) ──
  /// Portion of the ORIGINAL order's actual paid amount consumed as credit
  /// against this exchange. Stored so the same credit can never be consumed
  /// twice by a second exchange — the audit anchor for the settlement split.
  exchangedCreditAmount    Decimal?           @db.Decimal(10, 2)
  /// SETTLED_DUE (exchange cost > original paid; only the difference is
  /// collected) | SETTLED_EXACT (equal; nothing to collect or refund) |
  /// SETTLED_REFUND (exchange cost < original paid; difference refunded).
  settlementStatus         String?
  /// Extra collection this exchange still owes, or the refund it owes back
  /// (positive = collect, negative = refund). NULL until settlement runs.
  settlementDelta          Decimal?           @db.Decimal(10, 2)
  /// Set when the exchange lifecycle has been fully reconciled (refund
  /// completed / difference collected). Prevents re-running settlement.
  settlementSettledAt      DateTime?

  /// First-party technical context captured when the order was created.
  /// Set ONCE (same invariant as the customer snapshot below) — never updated.
  /// Present for storefront orders; staff/POS orders carry whatever the request
  /// had. Used for fraud/duplicate review and device analytics.
  ipAddress   String?
  userAgent   String?
  /// Immutable attribution snapshot: every raw landing signal that arrived with
  /// the order (utm_*, platform click ids, referrer, landing url, device block)
  /// plus the resolved platform/type. Frozen at creation so the order keeps its
  /// own answer to "where did this come from" even when the journey session is
  /// later overwritten or pruned. null = no signal at all was available.
  attribution Json?

  customer                     CustomerProfile?              @relation(fields: [customerId], references: [id])
  assignee                     UserProfile?                  @relation("OrderAssignee", fields: [assignedToId], references: [id])
  returnOfOrder                Order?                        @relation("OrderReturn", fields: [returnOfOrderId], references: [id])
  exchangeOfOrder              Order?                        @relation("OrderExchange", fields: [exchangeOfOrderId], references: [id])
  returnOrders                 Order[]                       @relation("OrderReturn")
  exchanges                    Order[]                       @relation("OrderExchange")
  status                       OrderStatus                   @relation(fields: [statusId], references: [id])
  items                        OrderItem[]
  payments                     Payment[]
  codAlerts                    CodMismatchAlert[]
  creditEntries                CustomerCreditEntry[]
  shipment                     Shipment?
  dispatchLogs                 CourierDispatchLog[]
  dispatches                   Dispatch[]
  refunds                      Refund[]
  exchangeRefunds             Refund[]                       @relation("RefundExchangeOrder")
  sourcePayments              Payment[]                      @relation("PaymentSourceOrder")
  couponUsages                 CouponUsage[]
  referralLeads                ReferralLead[]
  stockCycles                  OrderStockCycle[]
  stockTransfers               StockTransfer[]
  orderAttribution             OrderAttribution?
  marketingAllocations         MarketingCostAllocation[]
  commissionEarnings           CommissionEarning[]
  statusTransitions            OrderStatusTransition[]
  commissionLedgerV2           CommissionLedgerV2[]
  courierSettlementRows        CourierSettlementRow[]
  courierSettlementExceptions  CourierSettlementException[]
  courierSettlementAdjustments CourierSettlementAdjustment[]
  staffEvents                  OrderStaffEvent[]

  // At most one OPEN (not yet Returned) RTN per original order. A plain
  // unique is impossible: one original may legitimately accumulate several
  // RTNs over time once earlier ones are closed. Enforced in SQL by the
  // partial unique index `Order_returnOfOrderId_open_key` (see migration).
  @@index([exchangeOfOrderId])
  @@index([customerId])
  @@index([statusId])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([courierService])
  @@index([courierConsignmentId])
  @@index([courierTrackingCode])
  @@index([paymentOptionType])
  @@index([guestPhone])
  @@index([secondaryPhone])
  @@index([posSessionId])
  @@index([source])
  @@index([salesChannel])
  // Canonical attribution dimensions: analytics filters and breakdowns group on
  // these, and the backfill's work set is (channelMappedAt IS NULL, createdAt<=boundary).
  @@index([channel])
  @@index([sourceSlug])
  @@index([channelMappedAt])
  @@index([trackingSessionId])
  @@index([trashedAt])
  @@index([ipAddress])
  @@index([kind])
  @@index([returnOfOrderId])
  // Orders-list search: order number and guest name are matched as substrings.
  @@index([displayId(ops: raw("gin_trgm_ops"))], type: Gin, map: "Order_displayId_trgm_idx")
  @@index([guestName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Order_guestName_trgm_idx")
}

model OrderItem {
  id                   String   @id @default(uuid())
  orderId              String
  productId            String?
  variantId            String?
  comboId              String?
  comboSelection       Json?
  quantity             Int      @default(1)
  price                Decimal  @db.Decimal(10, 2)
  costSnapshot         Decimal? @db.Decimal(10, 2)
  costType             String? // 'estimated' | 'actual'
  managedStockReserved Boolean  @default(false)
  managedStockDeducted Boolean  @default(false)
  sourceWarehouseId    String?
  /// Set ONLY on RTN return-order items: the original sale-order item this
  /// return quantity came from. Links the return to the original stock
  /// consumption for exact costing-lot restoration.
  sourceOrderItemId    String?
  createdAt            DateTime @default(now())

  order           Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product?                  @relation(fields: [productId], references: [id])
  variant         ProductVariant?           @relation(fields: [variantId], references: [id])
  combo           Combo?                    @relation(fields: [comboId], references: [id])
  sourceWarehouse Warehouse?                @relation(fields: [sourceWarehouseId], references: [id])
  comboComponents OrderItemComboComponent[]
  marketingCosts  ProductMarketingCost[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([comboId])
  @@index([sourceWarehouseId])
  @@index([sourceOrderItemId])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  gatewayCode       String // Links to PaymentGateway.code (e.g., 'bkash', 'nagad', 'bkash_pgw', 'cash')
  amount            Decimal       @db.Decimal(10, 2)
  transactionId     String?
  providerPaymentId String?       @unique // bKash paymentID, bound at initiation
  screenshot        String?
  account           String?
  recordedBy        String?
  submittedBy       String? // "staff:<userId>" | "customer:<customerId>"
  recordedAt        DateTime      @default(now())
  status            PaymentStatus @default(PENDING)
  verifiedBy        String?
  verifiedAt        DateTime?
  notes             String?
  /// Gateway/processing fee for THIS payment (BDT). NULL = not recorded.
  feeAmount         Decimal?      @db.Decimal(10, 2)
  /// EXCHANGE settlement only: the ORIGINAL order whose paid amount this
  /// payment consumed as credit. NULL for every ordinary payment.
  sourceOrderId     String?
  /// Portion of THIS payment that was settled by carried-over credit rather
  /// than fresh money. NULL = a plain full-value payment (every normal order).
  appliedCreditAmount Decimal?    @db.Decimal(10, 2)
  createdAt         DateTime      @default(now())

  order    Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sourceOrder Order?    @relation("PaymentSourceOrder", fields: [sourceOrderId], references: [id])
  verifier UserProfile? @relation("VerifiedPayments", fields: [verifiedBy], references: [id])
  sourceRefunds Refund[] @relation("RefundSourcePayment")
  creditEntries CustomerCreditEntry[]

  @@unique([transactionId, gatewayCode])
  @@index([orderId])
  @@index([gatewayCode])
  @@index([transactionId])
  @@index([sourceOrderId])
}

model CodMismatchAlert {
  id            String   @id @default(uuid())
  orderId       String
  courier       String
  consignmentId String
  courierAmount Decimal  @db.Decimal(10, 2)
  systemDue     Decimal  @db.Decimal(10, 2)
  status        String   @default("open") // open | resolved | cleared
  resolvedBy    String?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@index([consignmentId])
}

model CustomerCreditEntry {
  id         String   @id @default(uuid())
