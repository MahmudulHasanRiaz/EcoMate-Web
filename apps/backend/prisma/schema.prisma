model OrderItemComboComponent {
  id            String  @id @default(uuid())
  orderItemId   String
  comboItemId   String // stable original ComboItem.id as plain string (NOT FK)
  productId     String
  variantId     String? // resolved effective variant ID at order creation time
  unitQuantity  Int // combo component quantity
  totalQuantity Int // unitQuantity * OrderItem.quantity (frozen snapshot)

  managedStockReserved Boolean  @default(false)
  managedStockDeducted Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  orderItem            OrderItem                           @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product              Product                             @relation(fields: [productId], references: [id])
  physicalReservations ComboComponentPhysicalReservation[]

  @@unique([orderItemId, comboItemId])
  @@index([orderItemId])
}

model ComboComponentPhysicalReservation {
  id          String   @id @default(uuid())
  componentId String // FK to OrderItemComboComponent
  orderId     String
  cycleId     String // FK to OrderStockCycle
  productId   String // denormalized for query/FIFO convenience
  variantId   String?
  warehouseId String
  quantity    Int
  status      String   @default("ACTIVE") // ACTIVE | CONSUMED | RELEASED | RESTORED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  component       OrderItemComboComponent                       @relation(fields: [componentId], references: [id], onDelete: Cascade)
  warehouse       Warehouse                                     @relation(fields: [warehouseId], references: [id])
  orderStockCycle OrderStockCycle                               @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  allocations     ComboComponentPhysicalReservationAllocation[]

  @@unique([componentId, cycleId])
  @@index([orderId])
  @@index([status])
}

model ComboComponentPhysicalReservationAllocation {
  id                  String  @id @default(uuid())
  reservationId       String
  physicalInventoryId String
  binLocationId       String?
  quantity            Int

  reservation       ComboComponentPhysicalReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  physicalInventory PhysicalInventory                 @relation(fields: [physicalInventoryId], references: [id])
  binLocation       BinLocation?                      @relation(fields: [binLocationId], references: [id])

  @@unique([reservationId, physicalInventoryId])
  @@index([reservationId])
}

model MobileBuild {
  id            String   @id @default(uuid())
  app           String // storefront | admin | pos
  platform      String // android | ios
  status        String   @default("queued") // queued | running | uploading | completed | failed | cancelled
  versionName   String   @default("1.0.0")
  versionCode   Int      @default(1)
  artifactPath  String?
  buildLogUrl   String?
  triggeredBy   String?
  triggeredById String?
  clientDomain  String?
  packageId     String?
  errorMessage  String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([app])
  @@index([status])
  @@index([createdAt])
}

model BackupJob {
  id           String    @id @default(cuid())
  type         String // manual | scheduled
  scope        String // db_only | db_files
  status       String    @default("pending") // pending | running | completed | failed | restoring
  fileKey      String? // storage path: backups/{id}/{filename}
  fileSize     BigInt? // total backup file size (bytes)
  checksum     String? // SHA-256 hex
  dbDumpSize   BigInt? // raw SQL dump size (bytes)
  filesSize    BigInt? // content archive size (bytes, null if db_only)
  locked       Boolean   @default(false)
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([type])
}

// ── Tracking pipeline (Phase 0, design v2 §15) ──────────────────────────────
// FKs are intentionally omitted: append-only log tables; orphan prevention is
// enforced in application code (capture writes snapshot+outbox atomically).

model TrackingContext {
  id          String   @id @default(uuid())
  ctxId       String   @unique
  externalId  String   @default(uuid()) // customer-keyed when auth known; journey-uuid fallback for guests
  ip          String?
  userAgent   String?
  url         String?
  referrer    String?
  identifiers Json     @default("{}") // per-key {value, firstSeenAt, lastSeenAt}; serialized merge
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([externalId])
  @@index([lastSeenAt]) // retention/anonymization
}

model TrackingSnapshot {
  id            String   @id @default(uuid())
  eventId       String   @unique
  eventType     String
  orderId       String?
  ctxId         String?
  eventTime     BigInt // Unix seconds; BigInt avoids INT4 2038 overflow
  actionSource  String?
  schemaVersion Int      @default(1)
  payload       Json
  createdAt     DateTime @default(now())

  // Exactly-once Purchase ledger: one canonical Purchase (and one Refund) per
  // business order. NULL orderIds (non-order browser events) never conflict in
  // Postgres. Deterministic eventId UNIQUE stays the first-line dedup guard.
  @@unique([orderId, eventType])
  @@index([orderId])
  @@index([eventType, createdAt])
  @@index([createdAt]) // retention/replay scans
}

model TrackingOutbox {
  id             String    @id @default(uuid())
  snapshotId     String    @unique
  configSnapshot Json      @default("{}")
  status         String    @default("PENDING") // PENDING | CLAIMED | SENT | FAILED | DEAD
  attemptCount   Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  priority       Int       @default(0) // higher = claimed first (Purchase/Refund high)
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  createdAt      DateTime  @default(now())
  publishedAt    DateTime?
  dispatchedAt   DateTime?

  @@index([status, priority, nextAttemptAt]) // claim query
  @@index([createdAt]) // retention
}

model TrackingDispatch {
  id                 String   @id @default(uuid())
  snapshotId         String
  eventId            String
  orderId            String?
  ctxId              String?
  queueJobId         String?
  provider           String
  // Immutable delivery-destination identity (Step 3). One dispatch row per
  // (snapshot, provider, destination) — legacy rows and pre-destination installs
  // carry 'default'. NOT NULL by design: a nullable column would let Postgres
  // treat NULLs as distinct and silently defeat the unique key below.
  destinationId      String   @default("default")
  // Pinned delivery identity: which dataset this row targets. Recorded so a later
  // pixel-id change cannot silently re-target history (a changed pixel id is a NEW
  // destination). The access token is deliberately NOT pinned — it is re-read at
  // send time so credential rotation works without rewriting historical rows.
  pixelId            String?
  status             String   @default("PENDING") // PENDING|SENDING|SENT|RETRY|FAILED|DEDUPED|SKIPPED|DEAD
  providerEventId    String?
  httpStatus         Int?
  responseBody       String?
  errorMsg           String?
  attemptCount       Int      @default(0)
  // SANITIZED AND BOUNDED snapshot of the provider-bound payload the adapter
  // sent — this is NOT the exact wire payload: secrets are redacted and
  // structure is truncated, and the sanitized form records `truncated` and
  // `redactedPaths` so the UI can disclose that it is incomplete. Null for
  // SKIPPED/DEDUPED (no send occurred). An exact, immutable, encrypted
  // wire-payload audit trail is a separate mechanism, out of scope here.
  payloadSnapshot    Json?
  adapterVersion     Int? // null for SKIPPED/DEDUPED (no send)
  providerApiVersion String? // null for SKIPPED/DEDUPED
  payloadVersion     Int? // null for SKIPPED/DEDUPED
  normalizerVersion  Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([snapshotId, provider, destinationId])
  @@index([provider, destinationId, status, createdAt])
  @@index([eventId, createdAt])
  @@index([orderId, createdAt])
  @@index([ctxId])
  @@index([createdAt]) // retention
}

model TrackingDispatchEvent {
  id         String   @id @default(uuid())
  snapshotId String
  eventId    String
  orderId    String?
  ctxId      String?
  provider   String?
  queueJobId String?
  fromStatus String?
  toStatus   String
  attempt    Int?
  message    String?
  createdAt  DateTime @default(now())

  @@index([snapshotId, createdAt])
  @@index([provider, toStatus, createdAt])
  @@index([eventId, createdAt])
  @@index([orderId, createdAt])
  @@index([ctxId])
  @@index([createdAt]) // retention
}

model TrackingReplayArchive {
  id              String   @id @default(uuid())
  snapshotId      String   @unique
  eventId         String
  eventType       String
  eventTime       BigInt
  archivedPayload Json     @default("{}") // canonical payload, PII-stripped (hashed keys only)
  configSnapshot  Json     @default("{}")
  versions        Json     @default("{}") // {schemaVersion, adapterVersion, providerApiVersion, payloadVersion, normalizerVersion}
  archivedAt      DateTime @default(now())

  @@index([eventId])
  @@index([eventType, archivedAt])
}

// ============================================================================
// MARKETING ATTRIBUTION PLATFORM (SPEC-001)
// ============================================================================

enum MarketingPlatformSlug {
  facebook
  google_ads
  tiktok
  linkedin
}

enum MarketingConnectionStatus {
  connected
  disconnected
  expired
  error
}

enum MarketingFundingStatus {
  draft
  confirmed
  posted
  partially_consumed
  fully_consumed
  archived
}

enum MarketingAllocationMethod {
  equal
  product_value
  quantity
}

enum MarketingPaymentStatus {
  pending
  reconciled
  needs_review
  failed
}

enum MarketingFundingType {
  paid
  promotional
}

enum OrderAttributionMethod {
  fbclid
  click_id
  conversion_api
  pixel
  session
  utm
  manual
}

model MarketingPlatform {
  id        String                @id @default(uuid())
  name      String
  slug      MarketingPlatformSlug @unique
  status    String                @default("active")
  createdAt DateTime              @default(now())

  connections MarketingConnection[]

  @@index([slug])
}

// ── Extensible source-platform registry ────────────────────────────────
// The canonical "Source" dimension. This is a REGISTRY, not an enum, on
// purpose: an enum would force a schema migration for every new platform and
// defeat the requirement that a platform can be added as data.
// (MarketingPlatform.slug above IS an enum — that is the trap being avoided.)
//
// `capabilities` drives filtering, e.g. a Messaging channel may only offer
// sources where capabilities contains MESSAGING. A registry entry existing is
// explicitly NOT the same as an integration being connected.
model SourcePlatform {
  slug         String   @id // 'facebook' | 'google' | 'chatgpt' | … (lowercase)
  displayName  String
  enabled      Boolean  @default(true)
  // MARKETING_SOURCE | MESSAGING | SOCIAL | AD_PLATFORM | AI_ASSISTANT
  capabilities String[]
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]

  // Capability filtering is a durable dependency (Messaging dropdown, channel
  // compatibility validation), so the array carries a GIN index — an unindexed
  // Postgres array cannot answer 'capabilities @> ARRAY[...]' efficiently.
  @@index([capabilities], type: Gin)
  @@index([enabled, sortOrder])
}

model MarketingConnection {
  id                 String                    @id @default(uuid())
  platformId         String
  providerUserId     String?
  providerBusinessId String?
  accessTokenEnc     String                    @db.Text
  refreshTokenEnc    String?                   @db.Text
  tokenType          String? // long-lived-user | system-user
  tokenExpiry        DateTime?
  status             MarketingConnectionStatus @default(connected)
  lastSyncAt         DateTime?
  lastError          String?                   @db.Text
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  platform   MarketingPlatform   @relation(fields: [platformId], references: [id])
  businesses MarketingBusiness[]
  adAccounts AdAccount[]

  @@index([platformId])
  @@index([status])
}

model MarketingBusiness {
  id                 String   @id @default(uuid())
  connectionId       String
  providerBusinessId String   @unique
  name               String
  createdAt          DateTime @default(now())

  connection MarketingConnection @relation(fields: [connectionId], references: [id])
  adAccounts AdAccount[]

  @@index([connectionId])
}

model AdAccount {
  id                      String    @id @default(uuid())
  connectionId            String
  businessId              String?
  providerAccountId       String    @unique // e.g. act_123456
  name                    String
  currency                String    @default("USD")
  timezone                String?
  status                  String    @default("ACTIVE")
  isActive                Boolean   @default(true)
  defaultPaymentAccountId String? // accounting wallet for auto-preselection
  lastSyncAt              DateTime?
  lastError               String?   @db.Text
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  connection     MarketingConnection      @relation(fields: [connectionId], references: [id])
  business       MarketingBusiness?       @relation(fields: [businessId], references: [id])
  campaigns      MarketingCampaign[]
  fundingEntries MarketingFundingEntry[]
  fundingLedger  MarketingFundingLedger[]
  payments       MarketingPayment[]
  syncStatus     MarketingSyncStatus?
  dailySummaries MarketingDailySummary[]

  @@index([connectionId])
  @@index([businessId])
}

model MarketingCampaign {
  id                  String    @id @default(uuid())
  adAccountId         String
  providerCampaignId  String    @unique
  name                String
  objective           String?
  buyingType          String?
  status              String    @default("ACTIVE") // ACTIVE | PAUSED | ARCHIVED | DELETED
  effectiveStatus     String?
  dailyBudget         Decimal?  @db.Decimal(14, 2)
  lifetimeBudget      Decimal?  @db.Decimal(14, 2)
  createdTime         DateTime?
  updatedTime         DateTime?
  startTime           DateTime?
  stopTime            DateTime?
  isArchived          Boolean   @default(false)
  deletedFromProvider Boolean   @default(false)
  lastSyncedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  adAccount         AdAccount                  @relation(fields: [adAccountId], references: [id])
  adSets            MarketingAdSet[]
  insights          MarketingCampaignInsight[]
  consumptions      MarketingConsumption[]
  orderAttributions OrderAttribution[]
  allocations       MarketingCostAllocation[]
  sessions          MarketingSession[]

  @@index([adAccountId])
  @@index([status])
  @@index([name])
  @@index([providerCampaignId])
}

model MarketingAdSet {
  id                  String    @id @default(uuid())
  campaignId          String
  providerAdSetId     String    @unique
  name                String
  status              String    @default("ACTIVE")
  optimizationGoal    String?
  billingEvent        String?
  bidStrategy         String?
  budget              Decimal?  @db.Decimal(14, 2)
  startTime           DateTime?
  endTime             DateTime?
  isArchived          Boolean   @default(false)
  deletedFromProvider Boolean   @default(false)
  lastSyncedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  campaign          MarketingCampaign       @relation(fields: [campaignId], references: [id])
  ads               MarketingAd[]
  insights          MarketingAdSetInsight[]
  orderAttributions OrderAttribution[]

  @@index([campaignId])
  @@index([providerAdSetId])
}

model MarketingAd {
  id                  String    @id @default(uuid())
  adSetId             String
  providerAdId        String    @unique
  name                String
  creativeId          String?
  creativeName        String?
  status              String    @default("ACTIVE")
  landingUrl          String?   @db.Text
  previewUrl          String?   @db.Text
  isArchived          Boolean   @default(false)
  deletedFromProvider Boolean   @default(false)
  lastSyncedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  adSet             MarketingAdSet       @relation(fields: [adSetId], references: [id])
  insights          MarketingAdInsight[]
  orderAttributions OrderAttribution[]
  sessions          MarketingSession[]

  @@index([adSetId])
  @@index([providerAdId])
}

// ---- Insight snapshots (immutable daily snapshots; unique per object+date) ----

model MarketingCampaignInsight {
  id            String   @id @default(uuid())
  campaignId    String
  date          DateTime @db.Date
  impressions   Int      @default(0)
  reach         Int      @default(0)
  clicks        Int      @default(0)
  cpc           Decimal? @db.Decimal(14, 4)
  cpm           Decimal? @db.Decimal(14, 4)
  ctr           Decimal? @db.Decimal(14, 4)
  spend         Decimal  @db.Decimal(14, 4)
  purchases     Int      @default(0)
  purchaseValue Decimal? @db.Decimal(14, 4)
  roas          Decimal? @db.Decimal(14, 4)
  frequency     Decimal? @db.Decimal(14, 4)
  syncedAt      DateTime @default(now())

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id])

  @@unique([campaignId, date])
  @@index([date])
}

model MarketingAdSetInsight {
  id            String   @id @default(uuid())
  adSetId       String
  date          DateTime @db.Date
  impressions   Int      @default(0)
  reach         Int      @default(0)
  clicks        Int      @default(0)
  cpc           Decimal? @db.Decimal(14, 4)
  cpm           Decimal? @db.Decimal(14, 4)
  ctr           Decimal? @db.Decimal(14, 4)
  spend         Decimal  @db.Decimal(14, 4)
  purchases     Int      @default(0)
  purchaseValue Decimal? @db.Decimal(14, 4)
  roas          Decimal? @db.Decimal(14, 4)
  frequency     Decimal? @db.Decimal(14, 4)
  syncedAt      DateTime @default(now())

  adSet MarketingAdSet @relation(fields: [adSetId], references: [id])

  @@unique([adSetId, date])
  @@index([date])
}

model MarketingAdInsight {
  id            String   @id @default(uuid())
  adId          String
  date          DateTime @db.Date
  impressions   Int      @default(0)
  reach         Int      @default(0)
  clicks        Int      @default(0)
  cpc           Decimal? @db.Decimal(14, 4)
  cpm           Decimal? @db.Decimal(14, 4)
  ctr           Decimal? @db.Decimal(14, 4)
  spend         Decimal  @db.Decimal(14, 4)
  purchases     Int      @default(0)
  purchaseValue Decimal? @db.Decimal(14, 4)
  roas          Decimal? @db.Decimal(14, 4)
  frequency     Decimal? @db.Decimal(14, 4)
  syncedAt      DateTime @default(now())

  ad MarketingAd @relation(fields: [adId], references: [id])

  @@unique([adId, date])
  @@index([date])
}

// ---- Funding / marketing accounting ----

model MarketingFundingEntry {
  id             String                 @id @default(uuid())
  platform       String                 @default("") // derived from connection.platform.slug
  adAccountId    String
  paymentId      String?
  fundingType    MarketingFundingType   @default(paid)
  fundingSource  String // BANK | DEBIT_CARD | CREDIT_CARD | WALLET | CASH | VIRTUAL_CARD
  fundingDate    DateTime
  currency       String                 @default("USD")
  currencyAmount Decimal                @db.Decimal(14, 4)
  baseCurrency   String                 @default("BDT")
  baseAmount     Decimal                @db.Decimal(14, 2)
  effectiveRate  Decimal                @db.Decimal(14, 4)
  feeAmount      Decimal?               @db.Decimal(14, 4) // optional platform/processing fee in currency
  taxAmount      Decimal?               @db.Decimal(14, 4) // optional tax in currency
  reference      String?
  remarks        String?                @db.Text
  journalEntryId String?                @unique
  status         MarketingFundingStatus @default(draft)
  createdBy      String?
  postedAt       DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  adAccount    AdAccount                @relation(fields: [adAccountId], references: [id])
  payment      MarketingPayment?        @relation(fields: [paymentId], references: [id])
  journalEntry JournalEntry?            @relation(fields: [journalEntryId], references: [id])
  ledger       MarketingFundingLedger[]

  @@index([adAccountId])
  @@index([fundingDate])
  @@index([status])
  @@index([paymentId])
}

model MarketingPayment {
  id                String                 @id @default(uuid())
  adAccountId       String
  providerPaymentId String?                @unique // platform's payment/charge ID
  platformAmount    Decimal                @db.Decimal(14, 4) // what platform charged
  platformCurrency  String                 @default("USD")
  actualCost        Decimal?               @db.Decimal(14, 2) // actual BDT debit (user-entered)
  baseCurrency      String                 @default("BDT")
  effectiveRate     Decimal?               @db.Decimal(14, 4) // derived: actualCost / platformAmount
  feeAmount         Decimal?               @db.Decimal(14, 4) // optional decomposition
  taxAmount         Decimal?               @db.Decimal(14, 4) // optional decomposition
  processingFee     Decimal?               @db.Decimal(14, 4) // optional decomposition
  sourceAccountId   String? // accounting wallet/account used for payment
  paymentDate       DateTime
  status            MarketingPaymentStatus @default(pending)
  notes             String?                @db.Text
  journalEntryId    String?                @unique
  reconciledAt      DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  adAccount      AdAccount               @relation(fields: [adAccountId], references: [id])
  sourceAccount  Account?                @relation(fields: [sourceAccountId], references: [id])
  journalEntry   JournalEntry?           @relation(fields: [journalEntryId], references: [id])
  fundingEntries MarketingFundingEntry[]

  @@index([adAccountId])
  @@index([paymentDate])
  @@index([status])
  @@index([providerPaymentId])
}

model MarketingFundingLedger {
  id              String                 @id @default(uuid())
  fundingEntryId  String
  adAccountId     String
  fundingType     MarketingFundingType   @default(paid)
  receivedAmount  Decimal                @db.Decimal(14, 4)
  remainingAmount Decimal                @db.Decimal(14, 4)
  effectiveRate   Decimal                @db.Decimal(14, 4)
  consumedAmount  Decimal                @default(0) @db.Decimal(14, 4)
  status          MarketingFundingStatus @default(confirmed)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  fundingEntry MarketingFundingEntry  @relation(fields: [fundingEntryId], references: [id])
  adAccount    AdAccount              @relation(fields: [adAccountId], references: [id])
  consumptions MarketingConsumption[]

  @@index([fundingEntryId])
  @@index([adAccountId])
  @@index([status])
}

model MarketingConsumption {
  id             String    @id @default(uuid())
  ledgerId       String
  campaignId     String?
  orderId        String?
  consumedAmount Decimal   @db.Decimal(14, 4) // spend currency units
  effectiveRate  Decimal   @db.Decimal(14, 4)
  calculatedCost Decimal   @db.Decimal(14, 2) // consumedAmount * effectiveRate
  spendDate      DateTime? @db.Date // insight date the spend belongs to
  source         String    @default("spend_sync") // spend_sync | allocation | replay | adjustment
  allocatedAt    DateTime  @default(now())

  ledger   MarketingFundingLedger @relation(fields: [ledgerId], references: [id])
  campaign MarketingCampaign?     @relation(fields: [campaignId], references: [id])

  @@index([ledgerId])
  @@index([campaignId])
  @@index([orderId])
  @@index([spendDate])
  @@index([allocatedAt])
}

// ---- Sessions / attribution ----

model MarketingSession {
  id           String    @id @default(uuid())
  visitorId    String
  sessionToken String    @unique // stable journey id (storefront ecomate_ctx_id)
  fbclid       String?
  clickId      String? // generic click identifier (provider-agnostic)
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  referrer     String?   @db.Text
  landingUrl   String?   @db.Text
  campaignId   String?
  adSetId      String?
  adId         String?
  ip           String?
  userAgent    String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  campaign          MarketingCampaign? @relation(fields: [campaignId], references: [id])
  ad                MarketingAd?       @relation(fields: [adId], references: [id])
  orderAttributions OrderAttribution[]

  @@index([visitorId])
  @@index([fbclid])
  @@index([clickId])
  @@index([utmCampaign])
  @@index([createdAt])
}

model OrderAttribution {
  id                 String                 @id @default(uuid())
  orderId            String                 @unique
  sessionId          String?
  campaignId         String?
  adSetId            String?
  adId               String?
  confidence         Int                    @default(0)
  method             OrderAttributionMethod
  explanation        String?                @db.Text
  attributionVersion Int                    @default(1)
  attributedAt       DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  order       Order                     @relation(fields: [orderId], references: [id])
  session     MarketingSession?         @relation(fields: [sessionId], references: [id])
  campaign    MarketingCampaign?        @relation(fields: [campaignId], references: [id])
  adSet       MarketingAdSet?           @relation(fields: [adSetId], references: [id])
  ad          MarketingAd?              @relation(fields: [adId], references: [id])
  allocations MarketingCostAllocation[]

  @@index([sessionId])
  @@index([campaignId])
  @@index([adId])
  @@index([attributedAt])
}

model OrderStaffEvent {
  id         String    @id @default(uuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  userId     String
  action     String
  fromStatus String?
  toStatus   String?
  note       String?
  metadata   Json?     @default("{}")
  createdAt  DateTime  @default(now())

  @@index([orderId])
  @@index([employeeId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([toStatus, createdAt])
  @@index([createdAt])
}

// ---- Cost allocation ----

model MarketingCostAllocation {
  id                String                    @id @default(uuid())
  orderId           String
  attributionId     String?
  campaignId        String
  allocatedSpend    Decimal                   @db.Decimal(14, 4)
  allocatedCurrency String                    @default("") // derived from AdAccount.currency
  allocatedRate     Decimal                   @db.Decimal(14, 4)
