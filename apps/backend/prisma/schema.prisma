  product  Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([productId])
}

model Expense {
  id               String          @id @default(uuid())
  description      String
  categoryId       String
  category         ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount           Decimal         @db.Decimal(10, 2)
  taxAmount        Decimal         @default(0) @db.Decimal(10, 2)
  expenseDate      DateTime
  paymentMethod    String? // kept for backward compat (pre-accounting)
  paymentAccountId String?
  paymentAccount   Account?        @relation(fields: [paymentAccountId], references: [id])
  journalEntryId   String?         @unique
  journalEntry     JournalEntry?   @relation(fields: [journalEntryId], references: [id])
  referenceNo      String?
  notes            String?         @db.Text
  receiptUrl       String?
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([categoryId])
  @@index([paymentAccountId])
  @@index([expenseDate])
  @@index([createdAt])
}

model NotificationSetting {
  id        String   @id @default(uuid())
  channel   String
  type      String
  enabled   Boolean  @default(true)
  config    Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channel, type])
}

model NotificationLog {
  id        String   @id @default(uuid())
  channel   String
  eventType String
  recipient String
  subject   String?
  content   String?  @db.Text
  status    String   @default("sent")
  error     String?
  metadata  Json?    @default("{}")
  sentAt    DateTime @default(now())

  @@index([channel, status])
  @@index([recipient])
  @@index([sentAt])
}

model Referral {
  id             String   @id @default(uuid())
  code           String   @unique
  referrerId     String
  totalReferrals Int      @default(0)
  totalReward    Decimal  @default(0) @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  referrer UserProfile      @relation(fields: [referrerId], references: [id])
  leads    ReferralLead[]
  rewards  ReferralReward[]

  @@index([referrerId])
  @@index([code])
}

model ReferralLead {
  id           String   @id @default(uuid())
  referralId   String
  phone        String
  name         String?
  status       String   @default("pending")
  orderId      String?
  rewardAmount Decimal? @db.Decimal(10, 2)
  rewardGiven  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id])

  @@index([referralId])
  @@index([phone])
  @@index([status])
}

model ReferralReward {
  id          String   @id @default(uuid())
  referralId  String
  type        String   @default("coupon")
  amount      Decimal  @db.Decimal(10, 2)
  description String?
  givenAt     DateTime @default(now())

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId])
}

enum EmploymentType {
  full_time
  part_time
  contract
  internship
}

enum EmployeeStatus {
  active
  inactive
  terminated
  resigned
  on_leave
  suspended
}

enum EmploymentHistoryField {
  status
  department
  designation
  reporting_manager
  employment_type
  weekly_off
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]
}

model Designation {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  level     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
}

model Employee {
  id                String         @id @default(uuid())
  betterAuthUserId  String         @unique
  employeeId        String         @unique
  departmentId      String?
  designationId     String?
  accessPresetId    String?
  reportingToId     String?
  employmentType    EmploymentType @default(full_time)
  status            EmployeeStatus @default(active)
  joiningDate       DateTime
  exitDate          DateTime?
  salary            Decimal?       @db.Decimal(10, 2)
  bankAccountNo     String?
  bankName          String?
  profilePictureUrl String?
  notes             String?        @db.Text
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  department       Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation      Designation?      @relation(fields: [designationId], references: [id], onDelete: SetNull)
  accessPreset     AccessPreset?     @relation(fields: [accessPresetId], references: [id], onDelete: SetNull)
  betterAuthUser   betterAuthUser    @relation(fields: [betterAuthUserId], references: [id], onDelete: Cascade)
  reportingTo      Employee?         @relation("EmployeeReports", fields: [reportingToId], references: [id], onDelete: SetNull)
  reports          Employee[]        @relation("EmployeeReports")
  salaryStructures SalaryStructure[]
  earnings         EmployeeEarning[]
  deductions       EmployeeDeduction[]
  payslips         Payslip[]
  history          EmploymentHistory[]
  weeklyOffs       WeeklyOff[]
  commissionRules  CommissionRule[]
  commissionEarnings CommissionEarning[]
  leaveRequests    LeaveRequest[]
  attendanceRecords AttendanceRecord[]

  @@index([departmentId])
  @@index([designationId])
  @@index([accessPresetId])
  @@index([reportingToId])
  @@index([status])
  @@index([status, departmentId])
}

enum PayslipStatus {
  draft
  reviewed
  approved
  partially_paid
  paid
  cancelled
}

model SalaryStructure {
  id                 String   @id @default(uuid())
  employeeId         String
  basicSalary        Decimal  @db.Decimal(10, 2)
  houseAllowance     Decimal  @default(0) @db.Decimal(10, 2)
  medicalAllowance   Decimal  @default(0) @db.Decimal(10, 2)
  transportAllowance Decimal  @default(0) @db.Decimal(10, 2)
  otherAllowance     Decimal  @default(0) @db.Decimal(10, 2)
  taxDeduction       Decimal  @default(0) @db.Decimal(10, 2)
  insuranceDeduction Decimal  @default(0) @db.Decimal(10, 2)
  otherDeduction     Decimal  @default(0) @db.Decimal(10, 2)
  totalEarnings      Decimal  @db.Decimal(10, 2)
  totalDeductions    Decimal  @default(0) @db.Decimal(10, 2)
  netSalary          Decimal  @db.Decimal(10, 2)
  effectiveFrom      DateTime  @default(now())
  effectiveTo        DateTime?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

enum EarningType {
  bonus
  incentive
  commission
  other
}

enum DeductionType {
  fine
  other
}

enum LedgerStatus {
  draft
  approved
  paid
}

enum CommissionAmountType {
  fixed
  percent
}

model EmployeeEarning {
  id             String       @id @default(uuid())
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type           EarningType
  amount         Decimal      @db.Decimal(10, 2)
  reason         String
  applicableFrom DateTime?
  applicableTo   DateTime?
  status         LedgerStatus @default(draft)
  payslipId      String?
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([employeeId, applicableFrom])
}

model EmployeeDeduction {
  id             String         @id @default(uuid())
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type           DeductionType
  amount         Decimal        @db.Decimal(10, 2)
  reason         String
  applicableFrom DateTime?
  applicableTo   DateTime?
  status         LedgerStatus   @default(draft)
  payslipId      String?
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([employeeId, applicableFrom])
}

model CommissionRule {
  id             String               @id @default(uuid())
  employeeId     String
  employee       Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  triggerStatusId String?
  triggerStatus  OrderStatus?         @relation(fields: [triggerStatusId], references: [id], onDelete: SetNull)
  amountType     CommissionAmountType
  amount         Decimal              @db.Decimal(10, 2)
  valueBasis     String               @default("order_total")
  minOrderAmount Decimal?             @db.Decimal(10, 2)
  capPerOrder    Decimal?             @db.Decimal(10, 2)
  isActive       Boolean              @default(true)
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  earnings       CommissionEarning[]
  @@index([employeeId, isActive])
}

model CommissionEarning {
  id         String       @id @default(uuid())
  employeeId String
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  ruleId     String
  rule       CommissionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount     Decimal      @db.Decimal(10, 2)
  status     LedgerStatus @default(approved)
  payslipId  String?
  createdAt  DateTime     @default(now())

  @@unique([orderId, ruleId])
  @@index([employeeId, createdAt])
}

model Payslip {
  id              String        @id @default(uuid())
  employeeId      String
  periodStart     DateTime
  periodEnd       DateTime
  totalEarnings   Decimal       @db.Decimal(10, 2)
  totalDeductions Decimal       @default(0) @db.Decimal(10, 2)
  netPay          Decimal       @db.Decimal(10, 2)
  status          PayslipStatus @default(draft)
  generatedAt     DateTime      @default(now())
  paidAt          DateTime?
  reviewedAt      DateTime?
  approvedAt      DateTime?
  periodKey       String?
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  employee Employee      @relation(fields: [employeeId], references: [id])
  items    PayslipItem[]
  payments  PayrollPayment[]

  @@index([employeeId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@unique([employeeId, periodKey])
}

model PayslipItem {
  id        String  @id @default(uuid())
  payslipId String
  type      String
  label     String
  amount    Decimal @db.Decimal(10, 2)

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
}

model PayrollPayment {
  id          String   @id @default(uuid())
  payslipId   String
  payslip     Payslip  @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(10, 2)
  paidAt      DateTime @default(now())
  method      String?
  referenceNo String?
  note        String?
  recordedById String?
  createdAt   DateTime @default(now())

  @@index([payslipId])
}

model EmploymentHistory {
  id            String                   @id @default(uuid())
  employeeId    String
  field         EmploymentHistoryField
  oldValue      String?
  newValue      String?
  effectiveFrom DateTime                 @default(now())
  changedById   String?
  createdAt     DateTime                 @default(now())

  employee  Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  changedBy UserProfile? @relation("EmploymentChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([employeeId, effectiveFrom])
}

model WeeklyOff {
  id            String   @id @default(uuid())
  employeeId    String
  dayOfWeek     Int
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?
  createdById   String?
  note          String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee  Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy UserProfile? @relation("WeeklyOffCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([employeeId, effectiveFrom])
}

enum AccountType {
  asset
  liability
  equity
  income
  expense
}

model Account {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  type        AccountType
  parentId    String?
  description String?     @db.Text
  isActive    Boolean     @default(true)
  isGroup     Boolean     @default(false)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  parent          Account?           @relation("AccountHierarchy", fields: [parentId], references: [id])
  children        Account[]          @relation("AccountHierarchy")
  openingBalances OpeningBalance[]
  journalLines    JournalEntryLine[]
  expenseCategory ExpenseCategory[]
  expensePayments Expense[]
  marketingPayments MarketingPayment[]

  @@index([type])
  @@index([parentId])
}

model FinancialPeriod {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  openingBalances OpeningBalance[]
  journalEntries  JournalEntry[]

  @@unique([startDate, endDate])
}

model OpeningBalance {
  id        String   @id @default(uuid())
  accountId String
  periodId  String
  debit     Decimal  @default(0) @db.Decimal(14, 2)
  credit    Decimal  @default(0) @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account         @relation(fields: [accountId], references: [id])
  period  FinancialPeriod @relation(fields: [periodId], references: [id])

  @@unique([accountId, periodId])
  @@index([periodId])
}

model JournalEntry {
  id          String   @id @default(uuid())
  entryNo     String   @unique
  periodId    String
  entryDate   DateTime
  description String
  totalDebit  Decimal  @db.Decimal(14, 2)
  totalCredit Decimal  @db.Decimal(14, 2)
  isOpening   Boolean  @default(false)
  referenceNo String?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  period  FinancialPeriod    @relation(fields: [periodId], references: [id])
  lines   JournalEntryLine[]
  expense Expense?
  marketingFunding MarketingFundingEntry?
  marketingPayment MarketingPayment?

  @@index([periodId])
  @@index([entryDate])
}

model JournalEntryLine {
  id          String   @id @default(uuid())
  entryId     String
  accountId   String
  debit       Decimal  @default(0) @db.Decimal(14, 2)
  credit      Decimal  @default(0) @db.Decimal(14, 2)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
}

model Warehouse {
  id        String        @id @default(uuid())
  name      String
  slug      String        @unique
  type      WarehouseType @default(main)
  address   String?
  city      String?
  country   String        @default("Bangladesh")
  phone     String?
  email     String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  products                           Product[]
  variants                           ProductVariant[]
  combos                             Combo[]
  zones                              Zone[]
  binLocations                       BinLocation[]
  posSessions                        PosSession[]
  physicalInventories                PhysicalInventory[]
  physicalLedgers                    PhysicalInventoryLedger[]
  physicalReservations               PhysicalReservation[]
  goodsReceiptNotes                  GoodsReceiptNote[]
  costingLots                        CostingLot[]
  transfersSource                    StockTransfer[]                     @relation("TransferSource")
  transfersDest                      StockTransfer[]                     @relation("TransferDest")
  comboComponentPhysicalReservations ComboComponentPhysicalReservation[]
  orderItems                         OrderItem[]

  @@index([isActive])
}

model Zone {
  id          String   @id @default(uuid())
  warehouseId String
  name        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse Warehouse     @relation(fields: [warehouseId], references: [id])
  racks     Rack[]
  bins      BinLocation[]

  @@unique([warehouseId, name])
  @@index([warehouseId])
}

model Rack {
  id        String   @id @default(uuid())
  zoneId    String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone    Zone          @relation(fields: [zoneId], references: [id])
  shelves Shelf[]
  bins    BinLocation[]

  @@unique([zoneId, name])
  @@index([zoneId])
}

model Shelf {
  id        String   @id @default(uuid())
  rackId    String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rack Rack          @relation(fields: [rackId], references: [id])
  bins BinLocation[]

  @@unique([rackId, name])
  @@index([rackId])
}

model BinLocation {
  id          String   @id @default(uuid())
  warehouseId String
  code        String
  zoneId      String?
  rackId      String?
  shelfId     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  warehouse                                    Warehouse                                     @relation(fields: [warehouseId], references: [id])
  zone                                         Zone?                                         @relation(fields: [zoneId], references: [id])
  rack                                         Rack?                                         @relation(fields: [rackId], references: [id])
  shelf                                        Shelf?                                        @relation(fields: [shelfId], references: [id])
  products                                     Product[]                                     @relation("ProductDefaultBin")
  variants                                     ProductVariant[]                              @relation("VariantBin")
  physicalInventories                          PhysicalInventory[]
  reservationAllocations                       PhysicalReservationAllocation[]
  comboComponentPhysicalReservationAllocations ComboComponentPhysicalReservationAllocation[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@index([zoneId])
  @@index([rackId])
  @@index([shelfId])
}

model CostingLot {
  id                  String   @id @default(uuid())
  purchaseId          String?
  grnId               String?
  productId           String
  variantId           String?
  warehouseId         String
  lotNumber           String   @unique
  unitCost            Decimal  @db.Decimal(12, 2)
  totalCost           Decimal  @db.Decimal(14, 2)
  quantity            Int
  remainingQty        Int
  receivedAt          DateTime @default(now())
  createdAt           DateTime @default(now())
  transferId          String?
  sourceConsumptionId String?  @unique

  purchase                   Purchase?               @relation(fields: [purchaseId], references: [id])
  grn                        GoodsReceiptNote?       @relation(fields: [grnId], references: [id])
  warehouse                  Warehouse               @relation(fields: [warehouseId], references: [id])
  transfer                   StockTransfer?          @relation(fields: [transferId], references: [id])
  consumptions               CostingLotConsumption[]
  sourceConsumption          CostingLotConsumption?  @relation("TransferDestinationLot", fields: [sourceConsumptionId], references: [id])
  transferSourceConsumptions CostingLotConsumption[] @relation("TransferSourceLot")

  @@index([productId, variantId, warehouseId, remainingQty])
  @@index([purchaseId])
  @@index([warehouseId])
  @@index([transferId])
}

model CostingLotConsumption {
  id            String                    @id @default(uuid())
  costingLotId  String
  type          CostingLotConsumptionType
  quantity      Int
  unitCost      Decimal                   @db.Decimal(12, 2)
  referenceType String
  referenceId   String
  cycleId       String?
  createdAt     DateTime                  @default(now())

  costingLot      CostingLot              @relation(fields: [costingLotId], references: [id])
  restorations    CostingLotRestoration[]
  sourceLot       CostingLot?             @relation("TransferSourceLot", fields: [sourceLotId], references: [id])
  sourceLotId     String?
  createdLot      CostingLot?             @relation("TransferDestinationLot")
  orderStockCycle OrderStockCycle?        @relation(fields: [cycleId], references: [id])

  @@unique([referenceType, referenceId, costingLotId, type])
  @@index([costingLotId])
  @@index([referenceType, referenceId])
  @@index([sourceLotId])
  @@index([cycleId])
}

model CostingLotRestoration {
  id                String   @id @default(uuid())
  consumptionId     String
  returnReferenceId String
  cycleId           String?
  quantity          Int
  unitCost          Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now())

  consumption     CostingLotConsumption @relation(fields: [consumptionId], references: [id])
  orderStockCycle OrderStockCycle?      @relation(fields: [cycleId], references: [id])

  @@unique([consumptionId, returnReferenceId])
  @@index([consumptionId])
  @@index([returnReferenceId])
  @@index([cycleId])
}

model StockTransfer {
  id                String    @id @default(uuid())
  idempotencyKey    String    @unique
  sourceWarehouseId String
  destWarehouseId   String
  status            String    @default("REQUESTED")
  notes             String?   @db.Text
  performedBy       String?
  requestedBy       String?
  orderId           String?
  order             Order?    @relation(fields: [orderId], references: [id])
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  sourceWarehouse Warehouse    @relation("TransferSource", fields: [sourceWarehouseId], references: [id])
  destWarehouse   Warehouse    @relation("TransferDest", fields: [destWarehouseId], references: [id])
  destinationLots CostingLot[]

  @@index([sourceWarehouseId])
  @@index([destWarehouseId])
  @@index([status])
  @@index([orderId])
}

model GoodsReceiptNote {
  id          String   @id @default(uuid())
  grnNumber   String   @unique
  purchaseId  String
  warehouseId String
  receivedBy  String?
  receivedAt  DateTime @default(now())
  status      String   @default("draft")
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  purchase    Purchase               @relation(fields: [purchaseId], references: [id])
  warehouse   Warehouse              @relation(fields: [warehouseId], references: [id])
  items       GoodsReceiptNoteItem[]
  costingLots CostingLot[]
}

model GoodsReceiptNoteItem {
  id             String  @id @default(uuid())
  grnId          String
  purchaseItemId String?
  productId      String
  variantId      String?
  expectedQty    Int
  receivedQty    Int
  acceptedQty    Int
  rejectedQty    Int     @default(0)
  unitCost       Decimal @db.Decimal(12, 2)
  totalCost      Decimal @db.Decimal(14, 2)

  grn GoodsReceiptNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
}

model SupplierPayment {
  id            String   @id @default(uuid())
  supplierId    String
  amount        Decimal  @db.Decimal(14, 2)
  paidAt        DateTime @default(now())
  paymentMethod String?
  reference     String?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())

  supplier Supplier                 @relation(fields: [supplierId], references: [id])
  invoices SupplierPaymentInvoice[]

  @@index([supplierId])
}

model SupplierPaymentInvoice {
  id        String @id @default(uuid())
  paymentId String
  invoiceNo String @unique

  payment SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model LicenseActivation {
  id           String    @id @default(uuid())
  licenseKey   String
  keymateUrl   String
  domain       String?
  apiKey       String?
  licenseInfo  Json?     @db.JsonB
  status       String    @default("pending")
  errorMessage String?
  activatedAt  DateTime?
  expiresAt    DateTime?
  lastCheckIn  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ProductFeedConfig {
  id                    String    @id @default(uuid())
  tenantId              String
  platform              String // meta, google, tiktok
  secureToken           String    @unique
  isActive              Boolean   @default(true)
  excludeOutOfStock     Boolean   @default(false)
  minPriceFilter        Decimal?  @db.Decimal(10, 2)
  googleProductCategory String?
  lastFetchedAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([tenantId])
  @@index([secureToken, isActive])
}

model ProductFeedLog {
  id         String   @id @default(uuid())
  tenantId   String
  platform   String
  ipAddress  String
  userAgent  String
  statusCode Int
  durationMs Int
  fetchedAt  DateTime @default(now())

  @@index([tenantId])
  @@index([fetchedAt])
}

model PageView {
  id        String   @id @default(uuid())
  url       String
  referrer  String?
  source    String?
  userAgent String?
  ip        String?
  sessionId String?
  timestamp DateTime @default(now())

  @@index([timestamp, sessionId])
  @@index([source, timestamp])
}

model OrderStockCycle {
  id        String   @id @default(uuid())
  orderId   String
  status    String   @default("ACTIVE") // ACTIVE | TERMINATED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order                Order                               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  physicalReservations PhysicalReservation[]
  comboReservations    ComboComponentPhysicalReservation[]
  costingConsumptions  CostingLotConsumption[]
  costingRestorations  CostingLotRestoration[]

  @@index([orderId])
  @@index([status])
}

model OrderItemComboComponent {
  id            String  @id @default(uuid())
  orderItemId   String
  comboItemId   String // stable original ComboItem.id as plain string (NOT FK)
  productId     String
  variantId     String? // resolved effective variant ID at order creation time
  unitQuantity  Int // combo component quantity
  totalQuantity Int // unitQuantity * OrderItem.quantity (frozen snapshot)

  managedStockReserved Boolean  @default(false)
  managedStockDeducted Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  orderItem            OrderItem                           @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product              Product                             @relation(fields: [productId], references: [id])
  physicalReservations ComboComponentPhysicalReservation[]

  @@unique([orderItemId, comboItemId])
  @@index([orderItemId])
}

model ComboComponentPhysicalReservation {
  id          String   @id @default(uuid())
  componentId String // FK to OrderItemComboComponent
  orderId     String
  cycleId     String // FK to OrderStockCycle
  productId   String // denormalized for query/FIFO convenience
  variantId   String?
  warehouseId String
  quantity    Int
  status      String   @default("ACTIVE") // ACTIVE | CONSUMED | RELEASED | RESTORED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  component       OrderItemComboComponent                       @relation(fields: [componentId], references: [id], onDelete: Cascade)
  warehouse       Warehouse                                     @relation(fields: [warehouseId], references: [id])
  orderStockCycle OrderStockCycle                               @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  allocations     ComboComponentPhysicalReservationAllocation[]

  @@unique([componentId, cycleId])
  @@index([orderId])
  @@index([status])
}

model ComboComponentPhysicalReservationAllocation {
  id                  String  @id @default(uuid())
  reservationId       String
  physicalInventoryId String
  binLocationId       String?
  quantity            Int

  reservation       ComboComponentPhysicalReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  physicalInventory PhysicalInventory                 @relation(fields: [physicalInventoryId], references: [id])
  binLocation       BinLocation?                      @relation(fields: [binLocationId], references: [id])

  @@unique([reservationId, physicalInventoryId])
  @@index([reservationId])
}

model MobileBuild {
  id            String   @id @default(uuid())
  app           String // storefront | admin | pos
  platform      String // android | ios
  status        String   @default("queued") // queued | running | uploading | completed | failed | cancelled
  versionName   String   @default("1.0.0")
  versionCode   Int      @default(1)
  artifactPath  String?
  buildLogUrl   String?
  triggeredBy   String?
  triggeredById String?
  clientDomain  String?
  packageId     String?
  errorMessage  String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([app])
  @@index([status])
  @@index([createdAt])
}

model BackupJob {
  id           String    @id @default(cuid())
  type         String // manual | scheduled
  scope        String // db_only | db_files
  status       String    @default("pending") // pending | running | completed | failed | restoring
  fileKey      String? // storage path: backups/{id}/{filename}
  fileSize     BigInt? // total backup file size (bytes)
  checksum     String? // SHA-256 hex
  dbDumpSize   BigInt? // raw SQL dump size (bytes)
  filesSize    BigInt? // content archive size (bytes, null if db_only)
  locked       Boolean   @default(false)
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([type])
}

// ── Tracking pipeline (Phase 0, design v2 §15) ──────────────────────────────
// FKs are intentionally omitted: append-only log tables; orphan prevention is
// enforced in application code (capture writes snapshot+outbox atomically).

model TrackingContext {
  id          String   @id @default(uuid())
  ctxId       String   @unique
  externalId  String   @default(uuid()) // customer-keyed when auth known; journey-uuid fallback for guests
  ip          String?
  userAgent   String?
  url         String?
  referrer    String?
  identifiers Json     @default("{}") // per-key {value, firstSeenAt, lastSeenAt}; serialized merge
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([externalId])
  @@index([lastSeenAt]) // retention/anonymization
}

model TrackingSnapshot {
  id            String   @id @default(uuid())
  eventId       String   @unique
  eventType     String
  orderId       String?
  ctxId         String?
  eventTime     BigInt // Unix seconds; BigInt avoids INT4 2038 overflow
  actionSource  String?
  schemaVersion Int      @default(1)
  payload       Json
  createdAt     DateTime @default(now())

  @@index([orderId])
  @@index([eventType, createdAt])
  @@index([createdAt]) // retention/replay scans
}

model TrackingOutbox {
  id             String    @id @default(uuid())
  snapshotId     String    @unique
  configSnapshot Json      @default("{}")
  status         String    @default("PENDING") // PENDING | CLAIMED | SENT | FAILED | DEAD
  attemptCount   Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  priority       Int       @default(0) // higher = claimed first (Purchase/Refund high)
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  createdAt      DateTime  @default(now())
  publishedAt    DateTime?
  dispatchedAt   DateTime?

  @@index([status, priority, nextAttemptAt]) // claim query
  @@index([createdAt]) // retention
}

model TrackingDispatch {
  id                 String   @id @default(uuid())
  snapshotId         String
  eventId            String
  orderId            String?
  ctxId              String?
  queueJobId         String?
  provider           String
  status             String   @default("PENDING") // PENDING|SENDING|SENT|RETRY|FAILED|DEDUPED|SKIPPED|DEAD
  providerEventId    String?
  httpStatus         Int?
  responseBody       String?
  errorMsg           String?
  attemptCount       Int      @default(0)
  adapterVersion     Int? // null for SKIPPED/DEDUPED (no send)
  providerApiVersion String? // null for SKIPPED/DEDUPED
  payloadVersion     Int? // null for SKIPPED/DEDUPED
  normalizerVersion  Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([snapshotId, provider])
  @@index([provider, status, createdAt])
  @@index([eventId, createdAt])
  @@index([orderId, createdAt])
  @@index([ctxId])
  @@index([createdAt]) // retention
}

model TrackingDispatchEvent {
  id         String   @id @default(uuid())
  snapshotId String
  eventId    String
  orderId    String?
  ctxId      String?
  provider   String?
  queueJobId String?
  fromStatus String?
  toStatus   String
  attempt    Int?
  message    String?
  createdAt  DateTime @default(now())

  @@index([snapshotId, createdAt])
  @@index([provider, toStatus, createdAt])
  @@index([eventId, createdAt])
  @@index([orderId, createdAt])
  @@index([ctxId])
  @@index([createdAt]) // retention
}

model TrackingReplayArchive {
  id              String   @id @default(uuid())
  snapshotId      String   @unique
  eventId         String
  eventType       String
  eventTime       BigInt
  archivedPayload Json     @default("{}") // canonical payload, PII-stripped (hashed keys only)
  configSnapshot  Json     @default("{}")
  versions        Json     @default("{}") // {schemaVersion, adapterVersion, providerApiVersion, payloadVersion, normalizerVersion}
archivedAt   DateTime @default(now())

  @@index([eventId])
  @@index([eventType, archivedAt])
}

// ============================================================================
// MARKETING ATTRIBUTION PLATFORM (SPEC-001)
// ============================================================================

enum MarketingPlatformSlug {
  facebook
  google_ads
  tiktok
  linkedin
}

enum MarketingConnectionStatus {
  connected
  disconnected
  expired
  error
}

enum MarketingFundingStatus {
  draft
  confirmed
  posted
  partially_consumed
  fully_consumed
  archived
}

enum MarketingAllocationMethod {
  equal
  product_value
  quantity
}

enum MarketingPaymentStatus {
  pending
  reconciled
  needs_review
  failed
}

enum MarketingFundingType {
  paid
  promotional
}

enum OrderAttributionMethod {
  fbclid
  click_id
  conversion_api
  pixel
  session
  utm
  manual
}

model MarketingPlatform {
  id          String                @id @default(uuid())
  name        String
  slug        MarketingPlatformSlug @unique
  status      String                @default("active")
  createdAt   DateTime              @default(now())

  connections MarketingConnection[]

  @@index([slug])
}

model MarketingConnection {
  id                 String                    @id @default(uuid())
  platformId         String
  providerUserId     String?
  providerBusinessId String?
  accessTokenEnc     String                    @db.Text
  refreshTokenEnc    String?                   @db.Text
  tokenType          String? // long-lived-user | system-user
  tokenExpiry        DateTime?
  status             MarketingConnectionStatus @default(connected)
  lastSyncAt         DateTime?
  lastError          String?                   @db.Text
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  platform   MarketingPlatform   @relation(fields: [platformId], references: [id])
  businesses MarketingBusiness[]
  adAccounts AdAccount[]

  @@index([platformId])
  @@index([status])
}

model MarketingBusiness {
  id                 String   @id @default(uuid())
  connectionId       String
  providerBusinessId String   @unique
  name               String
  createdAt          DateTime @default(now())

  connection MarketingConnection @relation(fields: [connectionId], references: [id])
  adAccounts AdAccount[]

  @@index([connectionId])
}

model AdAccount {
  id                       String   @id @default(uuid())
  connectionId             String
  businessId               String?
  providerAccountId        String   @unique // e.g. act_123456
  name                     String
  currency                 String   @default("USD")
  timezone                 String?
  status                   String   @default("ACTIVE")
  isActive                 Boolean  @default(true)
  defaultPaymentAccountId  String?  // accounting wallet for auto-preselection
  lastSyncAt               DateTime?
  lastError                String?  @db.Text
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  connection      MarketingConnection        @relation(fields: [connectionId], references: [id])
  business        MarketingBusiness?         @relation(fields: [businessId], references: [id])
  campaigns       MarketingCampaign[]
  fundingEntries  MarketingFundingEntry[]
  fundingLedger   MarketingFundingLedger[]
  payments        MarketingPayment[]
  syncStatus      MarketingSyncStatus?
  dailySummaries  MarketingDailySummary[]

  @@index([connectionId])
  @@index([businessId])
}

model MarketingCampaign {
  id                  String    @id @default(uuid())
  adAccountId         String
  providerCampaignId  String    @unique
  name                String
  objective           String?
  buyingType          String?
  status              String    @default("ACTIVE") // ACTIVE | PAUSED | ARCHIVED | DELETED
  effectiveStatus     String?
  dailyBudget         Decimal?  @db.Decimal(14, 2)
  lifetimeBudget      Decimal?  @db.Decimal(14, 2)
  createdTime         DateTime?
  updatedTime         DateTime?
  startTime           DateTime?
  stopTime            DateTime?
  isArchived          Boolean   @default(false)
  deletedFromProvider Boolean   @default(false)
  lastSyncedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  adAccount         AdAccount                    @relation(fields: [adAccountId], references: [id])
  adSets            MarketingAdSet[]
  insights          MarketingCampaignInsight[]
  consumptions      MarketingConsumption[]
  orderAttributions OrderAttribution[]
  allocations       MarketingCostAllocation[]
  sessions          MarketingSession[]

  @@index([adAccountId])
  @@index([status])
  @@index([name])
  @@index([providerCampaignId])
}

model MarketingAdSet {
  id                 String    @id @default(uuid())
  campaignId         String
  providerAdSetId    String    @unique
  name               String
  status             String    @default("ACTIVE")
  optimizationGoal   String?
  billingEvent       String?
  bidStrategy        String?
  budget             Decimal?  @db.Decimal(14, 2)
  startTime          DateTime?
  endTime            DateTime?
  isArchived         Boolean   @default(false)
  deletedFromProvider Boolean  @default(false)
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  campaign          MarketingCampaign        @relation(fields: [campaignId], references: [id])
  ads               MarketingAd[]
  insights          MarketingAdSetInsight[]
  orderAttributions OrderAttribution[]

  @@index([campaignId])
  @@index([providerAdSetId])
}

model MarketingAd {
  id                 String    @id @default(uuid())
  adSetId            String
  providerAdId       String    @unique
  name               String
  creativeId         String?
  creativeName       String?
  status             String    @default("ACTIVE")
  landingUrl         String?   @db.Text
  previewUrl         String?   @db.Text
  isArchived         Boolean   @default(false)
  deletedFromProvider Boolean  @default(false)
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  adSet             MarketingAdSet      @relation(fields: [adSetId], references: [id])
  insights          MarketingAdInsight[]
  orderAttributions OrderAttribution[]
  sessions          MarketingSession[]

  @@index([adSetId])
  @@index([providerAdId])
}

// ---- Insight snapshots (immutable daily snapshots; unique per object+date) ----

model MarketingCampaignInsight {
  id            String   @id @default(uuid())
  campaignId    String
  date          DateTime @db.Date
  impressions   Int      @default(0)
  reach         Int      @default(0)
  clicks        Int      @default(0)
  cpc           Decimal? @db.Decimal(14, 4)
  cpm           Decimal? @db.Decimal(14, 4)
  ctr           Decimal? @db.Decimal(14, 4)
  spend         Decimal  @db.Decimal(14, 4)
  purchases     Int      @default(0)
  purchaseValue Decimal? @db.Decimal(14, 4)
  roas          Decimal? @db.Decimal(14, 4)
  frequency     Decimal? @db.Decimal(14, 4)
  syncedAt      DateTime @default(now())

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id])

  @@unique([campaignId, date])
  @@index([date])
}

model MarketingAdSetInsight {
  id            String   @id @default(uuid())
  adSetId       String
  date          DateTime @db.Date
  impressions   Int      @default(0)
  reach         Int      @default(0)
  clicks        Int      @default(0)
  cpc           Decimal? @db.Decimal(14, 4)
  cpm           Decimal? @db.Decimal(14, 4)
  ctr           Decimal? @db.Decimal(14, 4)
  spend         Decimal  @db.Decimal(14, 4)
  purchases     Int      @default(0)
  purchaseValue Decimal? @db.Decimal(14, 4)
  roas          Decimal? @db.Decimal(14, 4)
  frequency     Decimal? @db.Decimal(14, 4)
  syncedAt      DateTime @default(now())

  adSet MarketingAdSet @relation(fields: [adSetId], references: [id])

  @@unique([adSetId, date])
  @@index([date])
}

model MarketingAdInsight {
  id            String   @id @default(uuid())
  adId          String
  date          DateTime @db.Date
  impressions   Int      @default(0)
  reach         Int      @default(0)
  clicks        Int      @default(0)
  cpc           Decimal? @db.Decimal(14, 4)
  cpm           Decimal? @db.Decimal(14, 4)
  ctr           Decimal? @db.Decimal(14, 4)
  spend         Decimal  @db.Decimal(14, 4)
  purchases     Int      @default(0)
  purchaseValue Decimal? @db.Decimal(14, 4)
  roas          Decimal? @db.Decimal(14, 4)
  frequency     Decimal? @db.Decimal(14, 4)
  syncedAt      DateTime @default(now())

  ad MarketingAd @relation(fields: [adId], references: [id])

  @@unique([adId, date])
  @@index([date])
}

// ---- Funding / marketing accounting ----

model MarketingFundingEntry {
  id              String                  @id @default(uuid())
  platform        String                  @default("") // derived from connection.platform.slug
  adAccountId     String
  paymentId       String?
  fundingType     MarketingFundingType    @default(paid)
  fundingSource   String // BANK | DEBIT_CARD | CREDIT_CARD | WALLET | CASH | VIRTUAL_CARD
  fundingDate     DateTime
  currency        String                  @default("USD")
  currencyAmount  Decimal                 @db.Decimal(14, 4)
  baseCurrency    String                  @default("BDT")
  baseAmount      Decimal                 @db.Decimal(14, 2)
  effectiveRate   Decimal                 @db.Decimal(14, 4)
  feeAmount       Decimal?                @db.Decimal(14, 4) // optional platform/processing fee in currency
  taxAmount       Decimal?                @db.Decimal(14, 4) // optional tax in currency
  reference       String?
  remarks         String?                 @db.Text
  journalEntryId  String?                 @unique
  status          MarketingFundingStatus  @default(draft)
  createdBy       String?
  postedAt        DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  adAccount    AdAccount                 @relation(fields: [adAccountId], references: [id])
  payment      MarketingPayment?         @relation(fields: [paymentId], references: [id])
  journalEntry JournalEntry?             @relation(fields: [journalEntryId], references: [id])
  ledger       MarketingFundingLedger[]

  @@index([adAccountId])
  @@index([fundingDate])
  @@index([status])
  @@index([paymentId])
}

model MarketingPayment {
  id                String                @id @default(uuid())
  adAccountId       String
  providerPaymentId String?               @unique // platform's payment/charge ID
  platformAmount    Decimal               @db.Decimal(14, 4) // what platform charged
  platformCurrency  String                @default("USD")
  actualCost        Decimal?              @db.Decimal(14, 2) // actual BDT debit (user-entered)
  baseCurrency      String                @default("BDT")
  effectiveRate     Decimal?              @db.Decimal(14, 4) // derived: actualCost / platformAmount
  feeAmount         Decimal?              @db.Decimal(14, 4) // optional decomposition
  taxAmount         Decimal?              @db.Decimal(14, 4) // optional decomposition
  processingFee     Decimal?              @db.Decimal(14, 4) // optional decomposition
  sourceAccountId   String?               // accounting wallet/account used for payment
  paymentDate       DateTime
  status            MarketingPaymentStatus @default(pending)
  notes             String?               @db.Text
  journalEntryId    String?               @unique
  reconciledAt      DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  adAccount     AdAccount              @relation(fields: [adAccountId], references: [id])
  sourceAccount Account?               @relation(fields: [sourceAccountId], references: [id])
  journalEntry  JournalEntry?          @relation(fields: [journalEntryId], references: [id])
  fundingEntries MarketingFundingEntry[]

  @@index([adAccountId])
  @@index([paymentDate])
  @@index([status])
  @@index([providerPaymentId])
}

model MarketingFundingLedger {
  id              String                 @id @default(uuid())
  fundingEntryId  String
  adAccountId     String
  fundingType     MarketingFundingType   @default(paid)
  receivedAmount  Decimal                @db.Decimal(14, 4)
  remainingAmount Decimal                @db.Decimal(14, 4)
  effectiveRate   Decimal                @db.Decimal(14, 4)
  consumedAmount  Decimal                @default(0) @db.Decimal(14, 4)
  status          MarketingFundingStatus @default(confirmed)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  fundingEntry MarketingFundingEntry  @relation(fields: [fundingEntryId], references: [id])
  adAccount    AdAccount              @relation(fields: [adAccountId], references: [id])
  consumptions MarketingConsumption[]

  @@index([fundingEntryId])
  @@index([adAccountId])
  @@index([status])
}

model MarketingConsumption {
  id             String   @id @default(uuid())
  ledgerId       String
  campaignId     String?
  orderId        String?
  consumedAmount Decimal  @db.Decimal(14, 4) // spend currency units
  effectiveRate  Decimal  @db.Decimal(14, 4)
  calculatedCost Decimal  @db.Decimal(14, 2) // consumedAmount * effectiveRate
  spendDate      DateTime? @db.Date // insight date the spend belongs to
  source         String   @default("spend_sync") // spend_sync | allocation | replay | adjustment
  allocatedAt    DateTime @default(now())

  ledger   MarketingFundingLedger @relation(fields: [ledgerId], references: [id])
  campaign MarketingCampaign?     @relation(fields: [campaignId], references: [id])

  @@index([ledgerId])
  @@index([campaignId])
  @@index([orderId])
  @@index([spendDate])
  @@index([allocatedAt])
}

// ---- Sessions / attribution ----

model MarketingSession {
  id           String   @id @default(uuid())
  visitorId    String
  sessionToken String   @unique // stable journey id (storefront ecomate_ctx_id)
  fbclid       String?
  clickId      String?  // generic click identifier (provider-agnostic)
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  referrer     String?  @db.Text
  landingUrl   String?  @db.Text
  campaignId   String?
  adSetId      String?
  adId         String?
  ip           String?
  userAgent    String?
  startedAt    DateTime @default(now())
  endedAt      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaign          MarketingCampaign?   @relation(fields: [campaignId], references: [id])
  ad                MarketingAd?         @relation(fields: [adId], references: [id])
  orderAttributions OrderAttribution[]

  @@index([visitorId])
  @@index([fbclid])
  @@index([clickId])
  @@index([utmCampaign])
  @@index([createdAt])
}

model OrderAttribution {
  id                 String                @id @default(uuid())
  orderId            String                @unique
  sessionId          String?
  campaignId         String?
  adSetId            String?
  adId               String?
  confidence         Int                   @default(0)
  method             OrderAttributionMethod
  explanation        String?               @db.Text
  attributionVersion Int                   @default(1)
  attributedAt       DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  order       Order                    @relation(fields: [orderId], references: [id])
  session     MarketingSession?        @relation(fields: [sessionId], references: [id])
  campaign    MarketingCampaign?       @relation(fields: [campaignId], references: [id])
  adSet       MarketingAdSet?          @relation(fields: [adSetId], references: [id])
  ad          MarketingAd?             @relation(fields: [adId], references: [id])
  allocations MarketingCostAllocation[]

  @@index([sessionId])
  @@index([campaignId])
  @@index([adId])
  @@index([attributedAt])
}

// ---- Cost allocation ----

model MarketingCostAllocation {
  id                String                  @id @default(uuid())
  orderId           String
  attributionId     String?
  campaignId        String
  allocatedSpend    Decimal                 @db.Decimal(14, 4)
  allocatedCurrency String                  @default("") // derived from AdAccount.currency
  allocatedRate     Decimal                 @db.Decimal(14, 4)
  allocatedCost     Decimal                 @db.Decimal(14, 2)
  allocationMethod  MarketingAllocationMethod
  calculatedAt      DateTime                @default(now())

  order       Order                    @relation(fields: [orderId], references: [id])
  attribution OrderAttribution?        @relation(fields: [attributionId], references: [id])
  campaign    MarketingCampaign        @relation(fields: [campaignId], references: [id])
  productCosts ProductMarketingCost[]

  @@unique([orderId, campaignId])
  @@index([campaignId])
  @@index([calculatedAt])
}

model ProductMarketingCost {
  id              String   @id @default(uuid())
  orderItemId     String
  allocationId    String
  marketingCost   Decimal  @db.Decimal(14, 2)
  allocationRatio Decimal  @db.Decimal(14, 6)
  calculatedAt    DateTime @default(now())

  allocation MarketingCostAllocation @relation(fields: [allocationId], references: [id])
  orderItem  OrderItem               @relation(fields: [orderItemId], references: [id])

  @@unique([orderItemId, allocationId])
  @@index([allocationId])
}

// ---- Sync / audit / observability ----

model MarketingSyncStatus {
  id              String   @id @default(uuid())
  adAccountId     String   @unique
  provider        String   @default("") // derived from connection.platform.slug
  status          String   @default("idle") // idle | running | error | partial
  stage           String? // businesses | ad_accounts | campaigns | adsets | ads | insights
  progressPct     Int      @default(0)
  lastRunAt       DateTime?
  lastSuccessAt   DateTime?
  lastError       String?  @db.Text
  recordsImported Int      @default(0)
  recordsUpdated  Int      @default(0)
  updatedAt       DateTime @updatedAt

  adAccount AdAccount @relation(fields: [adAccountId], references: [id])
}

model MarketingAuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  actorId    String?
  actorEmail String?
  metadata   Json?    @default("{}")
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

model MarketingRawPayload {
  id          String   @id @default(uuid())
  provider    String   @default("") // derived from connection.platform.slug
  endpoint    String
  objectType  String
  objectId    String?
  payloadJson Json
  receivedAt  DateTime @default(now())

  @@index([objectType, objectId])
  @@index([receivedAt])
}

// Snapshot aggregates (regenerable)
model MarketingDailySummary {
  id            String   @id @default(uuid())
  adAccountId   String
  date          DateTime @db.Date
  spend         Decimal  @default(0) @db.Decimal(14, 4)
  purchases     Int      @default(0)
  purchaseValue Decimal? @db.Decimal(14, 4)
  orders        Int      @default(0)
  revenue       Decimal? @db.Decimal(14, 2)
  marketingCost Decimal? @db.Decimal(14, 2)
  profit        Decimal? @db.Decimal(14, 2)
  roas          Decimal? @db.Decimal(14, 4)
  calculatedAt  DateTime @default(now())

  adAccount AdAccount @relation(fields: [adAccountId], references: [id])

  @@unique([adAccountId, date])
  @@index([date])
}

model MarketingDailyProductCost {
  id        String   @id @default(uuid())
  productId String
  date      DateTime @db.Date
  spend     Decimal  @default(0) @db.Decimal(14, 4)
  revenue   Decimal? @db.Decimal(14, 2)
  cost      Decimal? @db.Decimal(14, 2)
  profit    Decimal? @db.Decimal(14, 2)
  orders    Int      @default(0)
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, date])
  @@index([date])
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
}

model LeaveType {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  daysPerYear Int
  isPaid      Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests LeaveRequest[]
}

model LeaveRequest {
  id           String     @id @default(uuid())
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  typeId       String
  type         LeaveType  @relation(fields: [typeId], references: [id], onDelete: Restrict)
  startDate    DateTime
  endDate      DateTime
  days         Int
  reason       String
  status       LeaveStatus @default(pending)
  decisionNote String?
  approvedById String?
  approvedAt   DateTime?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId, startDate])
  @@index([status])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  WEEKLY_OFF
}

model AttendanceRecord {
  id           String           @id @default(uuid())
  employeeId   String
  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date         DateTime         @db.Date
  status       AttendanceStatus
  checkInTime  DateTime?
  checkOutTime DateTime?
  note         String?
  recordedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}
