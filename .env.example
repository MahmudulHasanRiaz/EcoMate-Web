# ==========================================
# ECOMATE WEB — PORTAINER STACK ENVIRONMENT
# ==========================================
# Copy this file to .env and fill in the values before deploying.
# Fields marked with ⭐ are REQUIRED and must be changed.

# ─────────────────────────────────────────
# 1. DOMAIN (⭐ REQUIRED)
# ─────────────────────────────────────────
# Your client's domain. Do NOT include https://
CLIENT_DOMAIN=example.com

# ─────────────────────────────────────────
# 2. REGISTRY + SEED ADMINS (⭐ REQUIRED)
# ─────────────────────────────────────────
# GitHub owner/org whose GHCR holds ecomate-* images
DOCKER_REGISTRY_OWNER=mahmudulhasanriaz
# Better-Auth secret + URL (backend session layer)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# First admin login (used by seed when RUN_SEED=true)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set to true only on the FIRST deploy to seed initial data
RUN_SEED=false
SEED_DUMMY_DATA=false

# ─────────────────────────────────────────
# 3. SECURITY SECRETS (⭐ REQUIRED — MUST CHANGE)
# ─────────────────────────────────────────
# Generate with: openssl rand -hex 64
# JWT_SECRET and JWT_REFRESH_SECRET MUST be different from each other
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# 256-bit AES key for marketing OAuth tokens at rest (64 hex chars).
# Generate with: openssl rand -hex 32
# REQUIRED on staging/prod — without it the backend falls back to an
# insecure default key and marketing sync fails with "Invalid ciphertext".
LICENSE_ENCRYPTION_KEY=

# Shared secret for internal service-to-service calls (storefront SSR →
# backend). When set (same value on both services), those calls carry an
# x-internal-secret header and are exempt from rate limiting — only from
# private-network addresses. Leave empty to disable the exemption.
INTERNAL_SHARED_SECRET=

# ─────────────────────────────────────────
# 4. DATABASE (⭐ REQUIRED — change password)
# ─────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ecomate_web
# Set to true only on the FIRST deploy to seed initial data
SEED_DUMMY_DATA=false
RUN_SEED=false
# Tracking-store retention sweep (PII anonymisation, outbox/snapshot purge).
# Leave empty/true for the default 90d/30d/2y windows; set to false to keep
# raw tracking rows indefinitely.
RETENTION_ENABLED=true

# Backend Node heap ceiling (MB). Node sizes its default heap from the cgroup
# limit, so inside the 1536M container it picked ~256M and startup died with
# "JavaScript heap out of memory" while Prisma loaded the schema. Keep this
# BELOW the backend service's memory limit in docker-compose.yml (1536M).
NODE_MAX_OLD_SPACE_SIZE=1280

# ─────────────────────────────────────────
# 5. PORT CONFIGURATION
# ─────────────────────────────────────────
# Change only if another stack already uses these ports on the host
# (multi-client servers). Must match portainer-stack.json defaults.
STOREFRONT_PORT=3000
BACKEND_PORT=4000
ADMIN_PORT=8080
POS_PORT=8081

# ─────────────────────────────────────────
# 6. ADDITIONAL URLS (auto-resolved from CLIENT_DOMAIN)
# ─────────────────────────────────────────
# These are automatically built from CLIENT_DOMAIN in docker-compose.yml.
# Only override if you need a non-standard setup.
CORS_ORIGIN=https://${CLIENT_DOMAIN}
APP_URL=https://${CLIENT_DOMAIN}
STOREFRONT_URL=https://${CLIENT_DOMAIN}
# ─────────────────────────────────────────
# 8. OPTIONAL OVERRIDES (all have working compose defaults)
# ─────────────────────────────────────────
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ecomate_web
# API_URL=http://backend:4000/api
# POS_URL=http://pos:80
# ADMIN_VITE_BASE=/admin/
# BACKUP_STORAGE_DIR=/app/backup-storage
# (Backup timeouts, R2, mobile-builder and pixel vars below all default
# sensibly — see docker-compose.yml and section 7.)
ADMIN_VITE_API_URL=/api
# POS Terminal sidebar link (e.g. https://pos.xyz.com/pos). Leave empty for
# auto-detect (admin.* -> pos.*, localhost -> :5174).
ADMIN_VITE_POS_URL=
STORE_NEXT_PUBLIC_API_URL=https://${CLIENT_DOMAIN}/api
STORE_NEXT_PUBLIC_STOREFRONT_URL=https://${CLIENT_DOMAIN}

# ─────────────────────────────────────────
# 7. TRACKING PIXELS (Optional)
# ─────────────────────────────────────────
# Can also be configured later from the Admin Panel → Settings → Tracking
META_PIXEL_ID=
META_ACCESS_TOKEN=
TIKTOK_PIXEL_CODE=
TIKTOK_ACCESS_TOKEN=
GA_MEASUREMENT_ID=
GA_API_SECRET=
GA_ADS_CONVERSION_ID=
GA_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA_ADS_CONVERSION_ID=
